---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import SeverityPill from '../components/SeverityPill.astro';
import Detail from '../components/Detail.astro';
import { vocab, ui, termHref, concept, branchOf, SEVERITIES } from '../lib/vocab';
import { pageMeta } from '../lib/pages';

const meta = await pageMeta('quality', 'Quality');
const checks = await Promise.all(
  vocab.checks.map(async (k) => {
    const e = await getEntry('checks', k.check);
    return { ...k, title: e?.data.title ?? k.check.replaceAll('_', ' '), Body: e ? (await render(e)).Content : null };
  }),
);
const titles = Object.fromEntries(checks.map((k) => [k.check, k.title]));
const passing = checks.filter((k) => !k.count);
const rows = Object.values(vocab.concepts).flatMap((c) => c.flags.map((f) => ({ c, f, branch: concept(branchOf(c)) })));
const branches = [...new Map(rows.map((r) => [r.branch.slug, r.branch])).values()].sort((a, b) => a.label.localeCompare(b.label));
const select = 'rounded-lg border border-base-200 bg-base-50 px-3 py-2 text-sm dark:border-base-700 dark:bg-base-800';
---
<Base {...meta} path="quality/">
  <PageIntro id="quality" fallbackTitle="Quality" />

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {checks.filter((k) => k.count).map((k) => (
      <section id={k.check} class="card scroll-mt-24 p-5 target:ring-2 target:ring-accent-300">
        <div class="flex items-start justify-between gap-3">
          <h2 class="font-semibold">{k.title}</h2>
          <div class="flex shrink-0 items-center gap-2">
            <SeverityPill severity={k.severity} />
            <button type="button" data-check={k.check} class="filter-check rounded-full bg-base-100 px-2 text-sm font-semibold tabular-nums hover:bg-accent-100 dark:bg-base-800" title="Show in table">{k.count}</button>
          </div>
        </div>
        {k.Body && <div class="prose-site prose-sm mt-2 text-sm"><k.Body /></div>}
      </section>
    ))}
  </div>

  {passing.length > 0 && (
    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-base-500">
      <span class="font-medium text-emerald-700 dark:text-emerald-400">✓ {ui.passing}:</span>
      {passing.map((k) => <a id={k.check} href={`#${k.check}`} class="chip scroll-mt-24" title={k.check}>{k.title}</a>)}
    </div>
  )}

  <section class="card mt-8 p-4 sm:p-6" id="table">
    <div class="mb-4 flex flex-wrap gap-2">
      <select id="f-sev" class={select} aria-label={ui.severity}>
        <option value="">{ui.severity}: {ui.all}</option>
        {SEVERITIES.map((s) => <option value={s}>{(ui as any)[`severity_${s}`]}</option>)}
      </select>
      <select id="f-check" class={select} aria-label={ui.check}>
        <option value="">{ui.check}: {ui.all}</option>
        {checks.filter((k) => k.count).map((k) => <option value={k.check}>{k.title}</option>)}
      </select>
      <select id="f-branch" class={select} aria-label={ui.branch}>
        <option value="">{ui.branch}: {ui.all}</option>
        {branches.map((b) => <option value={b.slug}>{b.label}</option>)}
      </select>
      <input id="f-text" type="search" placeholder={ui.filter_placeholder} class={`${select} min-w-0 flex-1`} />
      <span id="f-count" class="self-center text-sm text-base-500" aria-live="polite"></span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-base-200 text-base-500 dark:border-base-800">
          <tr>
            {[ui.concept, ui.branch, ui.severity, ui.check, ui.detail].map((h, i) => (
              <th class="whitespace-nowrap py-2 pr-4 font-medium"><button type="button" class="sort hover:text-base-900 dark:hover:text-white" data-col={i}>{h} ↕</button></th>
            ))}
          </tr>
        </thead>
        <tbody id="rows" class="divide-y divide-base-100 dark:divide-base-800">
          {rows.map(({ c, f, branch }) => (
            <tr data-sev={f.severity} data-check={f.check} data-branch={branch.slug} data-text={`${c.label} ${c.curie} ${f.detail.replace(/\[\[([^\]]+)\]\]/g, (_, k) => concept(k)?.label ?? k)}`.toLowerCase()}>
              <td class="py-2 pr-4"><a href={termHref(c.slug)} class="font-medium hover:text-accent-700 hover:underline dark:hover:text-accent-300">{c.label}</a> <span class="font-mono text-xs text-base-400">{c.curie}</span></td>
              <td class="py-2 pr-4 text-base-500">{branch.label}</td>
              <td class="py-2 pr-4" data-sort={SEVERITIES.indexOf(f.severity as any)}><SeverityPill severity={f.severity} /></td>
              <td class="py-2 pr-4"><a href={`#${f.check}`} class="hover:text-accent-700">{titles[f.check]}</a></td>
              <td class="py-2 text-base-500"><Detail text={f.detail} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  const tbody = document.getElementById('rows')!;
  const rows = [...tbody.querySelectorAll<HTMLTableRowElement>('tr')];
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const [sev, check, branch, text] = ['f-sev', 'f-check', 'f-branch', 'f-text'].map($);
  const count = document.getElementById('f-count')!;

  function apply() {
    const q = text.value.trim().toLowerCase();
    let n = 0;
    for (const r of rows) {
      const ok = (!sev.value || r.dataset.sev === sev.value) && (!check.value || r.dataset.check === check.value)
        && (!branch.value || r.dataset.branch === branch.value) && (!q || r.dataset.text!.includes(q));
      r.hidden = !ok;
      if (ok) n++;
    }
    count.textContent = `${n} / ${rows.length}`;
  }
  [sev, check, branch].forEach((el) => el.addEventListener('change', apply));
  text.addEventListener('input', apply);
  document.querySelectorAll<HTMLButtonElement>('.filter-check').forEach((b) =>
    b.addEventListener('click', () => { check.value = b.dataset.check!; apply(); document.getElementById('table')!.scrollIntoView({ behavior: 'smooth' }); }));

  let lastCol = -1, asc = true;
  document.querySelectorAll<HTMLButtonElement>('.sort').forEach((b) =>
    b.addEventListener('click', () => {
      const col = Number(b.dataset.col);
      asc = col === lastCol ? !asc : true; lastCol = col;
      const key = (r: HTMLTableRowElement) => { const td = r.cells[col]; return td.dataset.sort ?? td.textContent!.trim().toLowerCase(); };
      rows.sort((a, z) => (key(a) < key(z) ? -1 : key(a) > key(z) ? 1 : 0) * (asc ? 1 : -1));
      tbody.append(...rows);
    }));
  apply();
</script>
