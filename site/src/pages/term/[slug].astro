---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TermLink from '../../components/TermLink.astro';
import SeverityPill from '../../components/SeverityPill.astro';
import CopyButton from '../../components/CopyButton.astro';
import FieldValue from '../../components/FieldValue.astro';
import Hierarchy from '../../components/Hierarchy.astro';
import SuggestEdit from '../../components/SuggestEdit.astro';
import { vocab, ui, href, absolute, termHref, issueHref, concept, relationLabel, repoLinks, localName, type Concept, type Relation } from '../../lib/vocab';

export function getStaticPaths() {
  return Object.keys(vocab.concepts).map((slug) => ({ params: { slug } }));
}
const c: Concept = concept(Astro.params.slug!);
const path = `term/${c.slug}/`;
const links = repoLinks(c);
const notes = c.has_sidecar ? await getEntry('notes', c.slug) : undefined;
const Notes = notes ? (await render(notes)).Content : null;
const checkTitles = Object.fromEntries(
  await Promise.all(vocab.checks.map(async (k) => [k.check, (await getEntry('checks', k.check))?.data.title ?? k.check.replaceAll('_', ' ')])),
);

// Group relations by displayed label, keeping config order.
const groups = new Map<string, Relation[]>();
for (const def of vocab.relations) {
  for (const dir of ['out', 'in'] as const) {
    const rs = c.relations.filter((r) => r.key === def.key && r.direction === dir);
    if (rs.length) groups.set(relationLabel(def.key, dir), [...(groups.get(relationLabel(def.key, dir)) ?? []), ...rs]);
  }
}
const declared = vocab.extra_fields;
const extras = Object.entries(c.extras);
const shownExtras = extras.filter(([k]) => declared[k]);
const otherExtras = extras.filter(([k]) => !declared[k]);
const parent = c.parents[0] ? concept(c.parents[0]) : null;

const rdf = vocab.term_rdf
  ? [
      { type: 'text/turtle', label: 'Turtle', href: absolute(`term/${c.slug}.ttl`) },
      { type: 'application/ld+json', label: 'JSON-LD', href: absolute(`term/${c.slug}.jsonld`) },
    ]
  : [];

const jsonld = {
  '@context': { '@vocab': 'https://schema.org/', skos: 'http://www.w3.org/2004/02/skos/core#' },
  '@type': ['DefinedTerm', 'skos:Concept'],
  '@id': c.iri,
  url: absolute(path),
  name: c.label,
  'skos:prefLabel': c.label,
  termCode: c.curie,
  ...(c.definition ? { description: c.definition, 'skos:definition': c.definition } : {}),
  ...(c.synonyms.length ? { alternateName: c.synonyms, 'skos:altLabel': c.synonyms } : {}),
  ...(c.parents.length ? { 'skos:broader': c.parents.map((p) => ({ '@id': concept(p).iri })) } : {}),
  ...(c.children.length ? { 'skos:narrower': c.children.map((k) => ({ '@id': concept(k).iri })) } : {}),
  inDefinedTermSet: { '@type': 'DefinedTermSet', '@id': vocab.scheme.iri, name: vocab.scheme.label, url: absolute() },
  'skos:inScheme': { '@id': vocab.scheme.iri },
};
const h2 = 'eyebrow mb-4';
const section = 'border-t border-base-200 pt-6 dark:border-base-800';
const side = 'border-t border-base-200 pt-5 first:border-t-0 first:pt-0 dark:border-base-800';
---
<Base title={c.label} description={c.definition} path={path} jsonld={jsonld} alternates={rdf} index>
  <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-base-500 dark:text-base-400">
    <a href={href('browse/')} class="hover:text-accent-700">{ui.browse}</a>
    {c.ancestors.map((a) => (<><span aria-hidden="true">/</span><a href={termHref(a)} class="hover:text-accent-700 dark:hover:text-accent-300">{concept(a).label}</a></>))}
  </nav>

  <div class="grid grid-cols-1 gap-x-16 gap-y-10 lg:grid-cols-3">
    <article class="min-w-0 space-y-10 lg:col-span-2">
      <header>
        <div class="flex flex-wrap items-center gap-2" data-pagefind-ignore>
          <span class="rounded-md bg-base-100 px-2 py-0.5 font-mono text-xs text-base-600 dark:bg-base-800 dark:text-base-300" data-pagefind-meta="id">{c.curie}</span>
          {parent && <span class="text-sm text-base-500">in <TermLink slug={parent.slug} /></span>}
        </div>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl" data-pagefind-meta="title" data-pagefind-weight="10">{c.label}</h1>
        {c.definition && <p class="mt-4 max-w-3xl text-lg leading-relaxed text-base-700 dark:text-base-200">{c.definition}</p>}
        {c.synonyms.length > 0 && (
          <div class="mt-5">
            <h2 class="sr-only" data-pagefind-ignore>{ui.synonyms}</h2>
            <ul class="flex flex-wrap gap-2" aria-label={ui.synonyms} data-pagefind-weight="5">
              {c.synonyms.map((s) => <li class="chip">{s}</li>)}
            </ul>
          </div>
        )}
        <span class="sr-only">{c.curie}</span>
      </header>

      {shownExtras.length > 0 && (
        <section class={section}>
          <h2 class={h2}>{ui.fields}</h2>
          <dl class="space-y-4">
            {shownExtras.map(([k, v]) => (
              <div><dt class="text-sm font-medium text-base-500">{declared[k].label ?? k}</dt><dd class="mt-1"><FieldValue value={v} display={declared[k].display} /></dd></div>
            ))}
          </dl>
        </section>
      )}

      {Notes && (
        <section class={section}>
          <h2 class={h2}>{ui.notes}</h2>
          <div class="prose-site"><Notes /></div>
        </section>
      )}

      <section class={section} data-pagefind-ignore>
        <h2 class={h2}>{ui.hierarchy_section}</h2>
        <Hierarchy slug={c.slug} />
      </section>

      {groups.size > 0 && (
        <section class={section} data-pagefind-ignore>
          <h2 class={h2}>{ui.relations}</h2>
          <dl class="space-y-3">
            {[...groups].map(([label, rs]) => (
              <div class="grid grid-cols-1 gap-1 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-medium text-base-500"><a href={href(`schema/#${localName(vocab.relations.find((d) => d.key === rs[0].key)?.predicate)}`)} class="hover:text-accent-700">{label}</a></dt>
                <dd class="flex flex-wrap gap-x-4 gap-y-1">
                  {rs.map((r) => r.external ? (
                    r.iri ? <a class="font-mono text-sm hover:text-accent-700 hover:underline" href={r.iri}>{r.curie}</a> : <span class="font-mono text-sm">{r.curie}</span>
                  ) : (
                    <span><TermLink slug={r.target!} />{r.implied && <span class="ml-1 text-xs text-base-400">({ui.implied})</span>}</span>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {vocab.mappings.show && c.mappings.length > 0 && (
        <section class={section} data-pagefind-ignore>
          <h2 class={h2}>{ui.mappings}</h2>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-base-100 dark:divide-base-800">
              {c.mappings.map((m) => (
                <tr><td class="py-2 pr-3 text-base-500">{m.source}</td><td class="py-2 pr-3 font-mono text-xs">{m.predicate}</td><td class="py-2"><span class="font-mono">{m.object}</span>{m.object_label && <span class="text-base-500"> — {m.object_label}</span>}</td></tr>
              ))}
            </tbody>
          </table>
        </section>
      )}

      {otherExtras.length > 0 && (
        <section class={section} data-pagefind-ignore>
          <h2 class={h2}>{ui.other_fields}</h2>
          <dl class="space-y-3 text-sm">
            {otherExtras.map(([k, v]) => <div><dt class="font-mono text-base-500">{k}</dt><dd class="mt-1"><FieldValue value={v} /></dd></div>)}
          </dl>
        </section>
      )}

      <div data-pagefind-ignore><SuggestEdit c={c} issueUrl={links.issue} /></div>
    </article>

    <aside class="min-w-0 space-y-5 text-sm lg:border-l lg:border-base-200 lg:pl-8 dark:lg:border-base-800" data-pagefind-ignore>
      <section class={side}>
        <h2 class={h2}>{ui.quality}</h2>
        {c.flags.length === 0 ? <p class="text-base-500">{ui.no_flags}</p> : (
          <ul class="space-y-3">
            {c.flags.map((f) => (
              <li>
                <a href={issueHref(c.slug, f.check)} class="group block">
                  <span class="flex items-center gap-2"><SeverityPill severity={f.severity} /><span class="font-medium group-hover:text-accent-700 group-hover:underline">{checkTitles[f.check]} →</span></span>
                  {f.detail && <span class="mt-1 block text-base-500 dark:text-base-400">{f.detail.replace(/\[\[([^\]]+)\]\]/g, (_, k) => concept(k)?.label ?? k)}</span>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class={side}>
        <h2 class={h2}>{ui.identifiers}</h2>
        <dl class="space-y-3">
          <div><dt class="text-base-500">CURIE</dt><dd class="mt-0.5 flex items-center justify-between gap-2"><code class="font-mono">{c.curie}</code><CopyButton value={c.curie} /></dd></div>
          <div><dt class="text-base-500">IRI</dt><dd class="mt-0.5 flex items-center justify-between gap-2"><a class="break-all font-mono hover:text-accent-700 hover:underline dark:hover:text-accent-300" href={c.iri}>{c.iri}</a><CopyButton value={c.iri} /></dd></div>
        </dl>
        {rdf.length > 0 && <p class="mt-3 flex gap-3 text-base-500">{rdf.map((r) => <a class="hover:text-accent-700 hover:underline" href={r.href}>{r.label}</a>)}</p>}
      </section>

      <section class={side}>
        <h2 class={h2}>{ui.position}</h2>
        <p class="text-base-600 dark:text-base-300">{ui.depth} <span class="font-semibold tabular-nums">{c.depth}</span> · {ui.descendants} <span class="font-semibold tabular-nums">{c.descendants}</span></p>
        <a href={href(`browse/#${c.slug}`)} class="mt-2 inline-block font-medium text-accent-700 hover:underline dark:text-accent-300">{ui.browse} →</a>
      </section>

      {links.source && (
        <section class={side}>
          <h2 class={h2}>{ui.contribute}</h2>
          <ul class="space-y-2">
            {vocab.edits?.patches_dir && <li><a class="font-medium text-accent-700 hover:underline dark:text-accent-300" href="#suggest">{ui.suggest_edit} ↓</a></li>}
            <li><a class="text-base-600 hover:text-accent-700 hover:underline dark:text-base-300" href={links.source}>{ui.edit_source} ↗</a></li>
            <li><a class="text-base-600 hover:text-accent-700 hover:underline dark:text-base-300" href={links.notes}>{c.has_sidecar ? ui.edit_notes : ui.add_notes} ↗</a></li>
          </ul>
        </section>
      )}
    </aside>
  </div>
</Base>

<script>
  // Following a "Suggest an edit" link opens the form.
  document.querySelectorAll<HTMLAnchorElement>('a[href="#suggest"]').forEach((a) =>
    a.addEventListener('click', () => { const d = document.getElementById('suggest') as HTMLDetailsElement | null; if (d) d.open = true; }));
</script>
