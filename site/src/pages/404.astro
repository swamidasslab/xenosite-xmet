---
import Base from '../layouts/Base.astro';
import { ui, href } from '../lib/vocab';
---
<Base title={ui.not_found} path="404/">
  <div class="mx-auto max-w-xl py-16 text-center">
    <p class="text-6xl font-bold text-accent-500">404</p>
    <h1 class="mt-4 text-2xl font-semibold">{ui.not_found}</h1>
    <div class="mt-8 flex justify-center gap-3">
      <a href={href('browse/')} class="rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-700">{ui.browse}</a>
      <a href={href('search/')} class="rounded-full border border-base-300 px-5 py-2.5 text-sm font-semibold dark:border-base-700">{ui.search}</a>
    </div>
  </div>
</Base>
