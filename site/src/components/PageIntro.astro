---
// Title, summary, and Markdown body of a content page, used as the intro of app pages.
import { getEntry, render } from 'astro:content';
interface Props { id: string; fallbackTitle: string }
const { id, fallbackTitle } = Astro.props;
const entry = await getEntry('pages', id);
const Content = entry ? (await render(entry)).Content : null;
---
<header class="mb-8 max-w-3xl">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{entry?.data.title ?? fallbackTitle}</h1>
  {entry?.data.summary && <p class="mt-3 text-lg text-base-600 dark:text-base-300">{entry.data.summary}</p>}
  {Content && <div class="prose-site mt-4"><Content /></div>}
</header>
