---
// Pruned hierarchy showing where the given concepts sit: their ancestors, with
// unrelated siblings collapsed into a count.
import { vocab, concept, termHref } from '../lib/vocab';
interface Props { focus: string[]; node?: string; keep?: Set<string> }
const { focus, node } = Astro.props;
const keep = Astro.props.keep ?? new Set(focus.flatMap((s) => [...concept(s).ancestors, s]));
const roots = node ? [node] : vocab.roots.filter((r) => keep.has(r));
---
<ul class:list={[node ? 'ml-[7px] border-l border-base-200 pl-3 dark:border-base-800' : '']}>
  {roots.map((slug) => {
    const c = concept(slug);
    const shown = c.children.filter((k) => keep.has(k));
    const hidden = c.children.length - shown.length;
    const hit = focus.includes(slug);
    return (
      <li class="py-0.5">
        <a href={termHref(slug)} class:list={['inline-flex items-baseline gap-2 rounded px-1.5 py-0.5', hit ? 'bg-accent-100 font-semibold text-accent-900 ring-1 ring-accent-300 dark:bg-accent-900/50 dark:text-accent-100 dark:ring-accent-700' : 'hover:text-accent-700 dark:hover:text-accent-300']}>
          {c.label}<span class="font-mono text-[11px] font-normal text-base-400">{c.curie}</span>
        </a>
        {(shown.length > 0 || hidden > 0) && (
          <div>
            {shown.map((k) => <Astro.self focus={focus} node={k} keep={keep} />)}
            {hidden > 0 && <p class="ml-[7px] border-l border-base-200 pl-4 text-xs text-base-400 dark:border-base-800">+ {hidden} other</p>}
          </div>
        )}
      </li>
    );
  })}
</ul>
