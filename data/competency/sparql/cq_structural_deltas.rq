PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xmet:  <https://w3id.org/xenosite/xmet/>

SELECT DISTINCT ?term WHERE {
  ?term skos:broader+ xmet:4000220 .
  ?term skos:prefLabel ?label .
  FILTER(REGEX(LCASE(STR(?label)), "monooxygenation|oxygen gain|formula delta|demethylation delta|glucuronide mass"))
}
