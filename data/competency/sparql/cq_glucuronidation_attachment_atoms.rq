PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xmet:  <https://xenosite.org/ontology/xmet#>
PREFIX xmet: <https://xenosite.org/ontology/xmet#>

SELECT DISTINCT ?term ?atom WHERE {
  VALUES ?term {
    xmet:1300100 xmet:1300101 xmet:1300102 xmet:1300120 xmet:1300121
  }
  ?term xmet:hasAttachmentAtomType ?atom .
}
