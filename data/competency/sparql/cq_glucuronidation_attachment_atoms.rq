PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xmet:  <https://xenosite.org/ontology/xmet#>
PREFIX xmet: <https://xenosite.org/ontology/xmet#>

SELECT DISTINCT ?term ?atom WHERE {
  VALUES ?term {
    xmet:4000149 xmet:4000153 xmet:4000152 xmet:4000155 xmet:4000156
  }
  ?term xmet:hasAttachmentAtomType ?atom .
}
