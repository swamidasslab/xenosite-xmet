    {
      "id": "xmet:4000059",
      "type": "skos:Concept",
      "prefLabel": "quinone-like species formation",
      "inScheme": "xmet:scheme",
      "definition": "Aromatic→quinoid remodeling under conjugated-system remodeling: two distinct sites on an aromatic system are oxidized/dehydrogenated so the ring collapses into a non-aromatic conjugated quinoid (classical quinones, quinone-imines, quinone-methides, imine-methides). Not necessarily a composite pathway — an already hydroxylated precursor may need only terminating dehydrogenation. Specific multi-step routes may be modeled under composite transformation.",
      "altLabel": [
        "quinoid formation",
        "quinoid species formation",
        "quinone-like formation",
        "quinonation"
      ],
      "broader": "xmet:4000406",
      "relatedTo": [
        "xmet:4000272",
        "xmet:4000013",
        "xmet:4000006"
      ]
    },
    {
      "id": "xmet:4000060",
      "type": "skos:Concept",
      "prefLabel": "ortho-quinone formation",
      "inScheme": "xmet:scheme",
      "definition": "Formation of an ortho-quinone (1,2-diketone): two adjacent ring sites are oxidized/dehydrogenated, collapsing aromaticity into a conjugated non-aromatic ortho-quinoid. Narrow classical quinone, not quinone-imine/methide.",
      "altLabel": [
        "o-quinone formation",
        "1,2-quinone formation",
        "ortho-quinoid formation"
      ],
      "broader": "xmet:4000394"
    },
    {
      "id": "xmet:4000061",
      "type": "skos:Concept",
      "prefLabel": "para-quinone formation",
      "inScheme": "xmet:scheme",
      "definition": "Formation of a para-quinone (1,4-diketone): two para-related ring sites are oxidized/dehydrogenated, collapsing aromaticity into a conjugated non-aromatic para-quinoid. Narrow classical quinone, not quinone-imine/methide.",
      "altLabel": [
        "p-quinone formation",
        "1,4-quinone formation",
        "para-quinoid formation"
      ],
      "broader": "xmet:4000394"
    },
    {
      "id": "xmet:4000062",
      "type": "skos:Concept",
      "prefLabel": "quinone-imine formation",
      "inScheme": "xmet:scheme",
      "definition": "Formation of a quinone-imine: one or both quinoid ends are C=N rather than C=O. Two distinct sites are dehydrogenated so an aromatic system collapses into a non-aromatic conjugated quinoid (e.g. NAPQI-type). Sibling of classical quinone formation under quinone-like species formation.",
      "altLabel": [
        "quinone imine formation",
        "NAPQI-type formation",
        "quinoid imine formation"
      ],
      "broader": "xmet:4000059"
    },
    {
      "id": "xmet:4000063",
      "type": "skos:Concept",
      "prefLabel": "quinone-methide formation",
      "inScheme": "xmet:scheme",
      "definition": "Formation of a quinone-methide: a quinoid with an exocyclic alkylidene/methide end (including imine-methide variants). Two distinct sites are dehydrogenated so an aromatic system collapses into a non-aromatic conjugated quinoid. Sibling of classical quinone formation under quinone-like species formation.",
      "altLabel": [
        "quinone methide formation",
        "quinoid methide formation"
      ],
      "broader": "xmet:4000059"
    },
    {
      "id": "xmet:4000064",
      "type": "skos:Concept",
      "prefLabel": "iminium ion formation",
