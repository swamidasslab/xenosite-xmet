      "prefLabel": "terminal observable step",
      "inScheme": "xmet:scheme",
      "definition": "Last enumerated step yielding the reported metabolite.",
      "broader": "xmet:7900000"
    },
    {
      "id": "xmet:7900005",
      "type": "skos:Concept",
      "prefLabel": "pathway-step role unspecified",
      "inScheme": "xmet:scheme",
      "definition": "Step role in a path is not asserted.",
      "broader": "xmet:7900000"
    },
    {
      "id": "xmet:8000000",
      "type": "skos:Concept",
      "prefLabel": "aromatic and conjugated-system impact",
      "inScheme": "xmet:scheme",
      "definition": "Parallel hierarchy focused on how a transformation impacts aromatic and conjugated π-systems: loss or gain of aromaticity, engagement of conjugated acceptors, and rearrangements within those systems. Orthogonal to both the chemist reaction-type spine and the Metabolic Forest map.",
      "altLabel": [
        "aromatic/conjugate impact",
        "π-system impact"
      ],
      "broader": "xmet:1700000"
    },
    {
      "id": "xmet:8000001",
      "type": "skos:Concept",
      "prefLabel": "aromaticity loss",
      "inScheme": "xmet:scheme",
      "definition": "Transformations that destroy or interrupt an aromatic system.",
      "broader": "xmet:8000000",
      "relatedMatch": "xmet:0004001"
    },
    {
      "id": "xmet:8000002",
      "type": "skos:Concept",
      "prefLabel": "aromaticity gain",
      "inScheme": "xmet:scheme",
      "definition": "Transformations that form or restore an aromatic system.",
      "broader": "xmet:8000000",
      "relatedMatch": [
        "xmet:0004002",
        "xmet:0000315"
      ]
    },
    {
      "id": "xmet:8000003",
      "type": "skos:Concept",
      "prefLabel": "aromatic ring substitution impact",
      "inScheme": "xmet:scheme",
      "definition": "Substitution on an aromatic ring that preserves the aromatic sextet (e.g. phenolic hydroxylation after NIH shift).",
      "broader": "xmet:8000000",
      "relatedMatch": [
        "xmet:0000101",
        "xmet:0004003",
        "xmet:0004004"
      ]
    },
    {
      "id": "xmet:8000004",
      "type": "skos:Concept",
      "prefLabel": "conjugated π-system engagement",
      "inScheme": "xmet:scheme",
      "definition": "Reactions whose defining impact is engagement of a conjugated acceptor or donor (Michael acceptors, quinoids, extended enones).",
      "broader": "xmet:8000000",
      "relatedMatch": [
        "xmet:0004014",
        "xmet:0000300",
        "xmet:0001031"
      ]
    },
    {
      "id": "xmet:8000005",
      "type": "skos:Concept",
      "prefLabel": "quinoid π-system formation",
      "inScheme": "xmet:scheme",
      "definition": "Formation of quinone, quinone-imine, quinone-methide, or imine-methide π-systems from aromatic or conjugated precursors.",
      "broader": "xmet:8000000",
      "relatedMatch": [
        "xmet:0000300",
        "xmet:0000303",
        "xmet:0000304",
        "xmet:0000306"
      ]
    },
    {
      "id": "xmet:8000006",
      "type": "skos:Concept",
      "prefLabel": "heteroaromatic oxidation impact",
      "inScheme": "xmet:scheme",
      "definition": "Oxidation paths that specifically perturb heteroaromatic rings (e.g. thiophene S-oxidation or epoxidation).",
      "broader": "xmet:8000000",
      "relatedMatch": [
        "xmet:0000133",
        "xmet:0000113"
      ]
    },
    {
      "id": "xmet:8000007",
      "type": "skos:Concept",
      "prefLabel": "arene oxide pathway",
      "inScheme": "xmet:scheme",
      "definition": "Passage through an arene oxide / NIH-shift manifold on an aromatic ring.",
      "broader": "xmet:8000000",
      "relatedMatch": [
        "xmet:0000112",
        "xmet:0004003",
        "xmet:0004005"
      ]
    },
    {
