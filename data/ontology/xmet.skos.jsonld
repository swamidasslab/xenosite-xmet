  "@graph": [
    {
      "id": "xmet:scheme",
      "type": "skos:ConceptScheme",
      "prefLabel": "Xenobiotic Reaction Metabolism",
      "iri": "https://w3id.org/xenosite/xmet/",
      "definition": "Metabolism-specific med-chem SKOS thesaurus for xenobiotic reaction naming — not a full chemical ontology. Site-localized display names use templates outside the concept scheme. SSSOM maps to RXNO/MOP/GO/ChEBI/Rhea/KEGG/MeSH/ECO/CHMO."
    },
    {
      "id": "xmet:4000000",
      "type": "skos:Concept",
      "prefLabel": "xenobiotic biotransformation",
      "inScheme": "xmet:scheme",
      "definition": "Chemical alteration of an exogenous substance in a biological system.",
      "altLabel": [
        "xenobiotic metabolism",
        "biotransformation",
        "drug metabolism"
      ],
      "topConcept": true
    },
    {
      "id": "xmet:4000001",
      "type": "skos:Concept",
      "prefLabel": "phase I",
      "inScheme": "xmet:scheme",
      "definition": "Functionalization stage tag: oxidation, reduction, hydrolysis, and related edits that introduce or expose polar groups. Not a chemical superclass.",
      "altLabel": [
        "phase 1",
        "functionalization",
        "Metabolic Detoxication, Phase I",
        "phase 1 metabolism",
        "functionalization phase"
      ],
      "broader": "xmet:4000212"
    },
    {
      "id": "xmet:4000002",
      "type": "skos:Concept",
      "prefLabel": "phase II",
      "inScheme": "xmet:scheme",
      "definition": "Conjugation stage tag: binding to endogenous moieties. Not a chemical superclass — transfer conjugations and adducts are distinguished under reaction class.",
      "altLabel": [
        "phase 2",
        "Metabolic Detoxication, Phase II",
        "phase 2 metabolism",
        "conjugation phase"
      ],
      "broader": "xmet:4000212"
    },
    {
      "id": "xmet:4000003",
      "type": "skos:Concept",
      "prefLabel": "phase III",
      "inScheme": "xmet:scheme",
      "definition": "Further handling / transport / excretion-related disposition of conjugates and metabolites. Disposition tag, not a reaction class.",
      "altLabel": [
        "phase 3",
        "phase III",
        "transport phase"
      ],
      "broader": "xmet:4000212"
    },
    {
      "id": "xmet:4000004",
      "type": "skos:Concept",
      "prefLabel": "stable oxygenation",
      "inScheme": "xmet:scheme",
      "definition": "Oxygenation that yields a stable oxygenated metabolite (aromatic/aliphatic hydroxylation, epoxidation, N-oxidation, S-oxidation).",
      "altLabel": [
        "SO class",
        "stable oxygen addition class",
        "Rainbow stable oxygenation",
        "SO class (full name)",
        "stable_oxygenation"
      ],
      "broader": "xmet:4000009"
    },
    {
      "id": "xmet:4000005",
      "type": "skos:Concept",
      "prefLabel": "unstable oxygenation",
      "inScheme": "xmet:scheme",
      "definition": "Oxygenation that triggers cleavage or rearrangement (N-/O-/S-/C-dealkylation, oxidative deamination, oxidative dehalogenation).",
      "altLabel": [
        "UO class",
        "unstable oxygen addition class",
        "Rainbow unstable oxygenation",
        "UO class (full name)",
        "unstable_oxygenation"
      ],
      "broader": "xmet:4000009"
    },
    {
      "id": "xmet:4000006",
      "type": "skos:Concept",
      "prefLabel": "dehydrogenation",
      "inScheme": "xmet:scheme",
      "definition": "Extract hydrogen(s) to form a multiple bond, iminium, or quinoid. Nested under oxidation. Often an elementary part of conjugated-system remodeling (including quinone-like paths).",
      "altLabel": [
        "desaturation"
      ],
      "broader": "xmet:4000009",
      "isPartOf": "xmet:4000406",
      "relatedTo": "xmet:4000059"
    },
    {
      "id": "xmet:4000007",
      "type": "skos:Concept",
      "prefLabel": "hydrolysis",
      "inScheme": "xmet:scheme",
      "definition": "Water addition cleaves amide, ester, ether, or related bonds. Nested under isoredox (redox-neutral).",
      "broader": "xmet:4000265",
      "relatedTo": "xmet:4000077"
    },
    {
      "id": "xmet:4000008",
      "type": "skos:Concept",
      "prefLabel": "reduction",
      "inScheme": "xmet:scheme",
      "definition": "Remove oxygen or add hydrogen(s) (nitro, carbonyl, sulfo reduction; reductive dehalogenation; hydrogenation). Peer of oxidation and isoredox under reaction class.",
      "broader": "xmet:4000213",
      "relatedTo": "xmet:4000113"
    },
    {
      "id": "xmet:4000009",
      "type": "skos:Concept",
      "prefLabel": "oxidation",
      "inScheme": "xmet:scheme",
      "definition": "Oxidations and related increase of oxidation state. Holds stable oxygenation, unstable oxygenation, and dehydrogenation.",
      "altLabel": [
        "oxidative metabolism"
      ],
      "broader": "xmet:4000213"
    },
    {
      "id": "xmet:4000010",
      "type": "skos:Concept",
      "prefLabel": "heteroatom oxidation",
      "inScheme": "xmet:scheme",
      "definition": "Direct oxidation of N, S (and related heteroatoms).",
      "broader": "xmet:4000004"
    },
    {
      "id": "xmet:4000011",
      "type": "skos:Concept",
      "prefLabel": "conjugation",
      "inScheme": "xmet:scheme",
      "definition": "Addition of an endogenous or trapping moiety. Split into transfer conjugation (clearance-oriented) and adduct formation (electrophile capture).",
      "broader": "xmet:4000213",
      "closeMatch": "xmet:4000002",
      "antonymOf": "xmet:4000147"
    },
    {
      "id": "xmet:4000012",
      "type": "skos:Concept",
      "prefLabel": "hydroxylation",
      "inScheme": "xmet:scheme",
      "definition": "Introduction of a hydroxyl group, typically at carbon.",
      "altLabel": [
        "C-hydroxylation",
        "monooxygenation hydroxylation",
        "hydroxylation to alcohol",
        "hydroxylation to alcohol or oxide"
      ],
      "broader": "xmet:4000004",
      "antonymOf": "xmet:4000128",
      "relatedTo": "xmet:4000203"
    },
    {
      "id": "xmet:4000013",
      "type": "skos:Concept",
      "prefLabel": "aromatic hydroxylation",
      "inScheme": "xmet:scheme",
      "definition": "Hydroxylation of an aromatic ring; often via arene oxide / NIH-shift pathways. Often an elementary part of conjugated-system remodeling toward quinone-like species.",
      "altLabel": [
        "aryl hydroxylation",
        "benzene hydroxylation",
        "arene hydroxylation",
        "aromatic hydroxylation to phenol",
        "aromatic hydroxylation to phenol or phenolate"
      ],
      "broader": "xmet:4000012",
      "isPartOf": "xmet:4000406",
      "relatedTo": "xmet:4000059"
    },
    {
      "id": "xmet:4000014",
      "type": "skos:Concept",
      "prefLabel": "aliphatic hydroxylation",
      "inScheme": "xmet:scheme",
      "definition": "Hydroxylation of an aliphatic carbon (not limited to methyl/methylene; see also tertiary carbon hydroxylation under methine hydroxylation).",
      "altLabel": [
        "alkyl hydroxylation"
      ],
      "broader": "xmet:4000380"
    },
    {
      "id": "xmet:4000015",
      "type": "skos:Concept",
      "prefLabel": "para-hydroxylation",
      "inScheme": "xmet:scheme",
      "definition": "Para-regioselective aromatic hydroxylation.",
      "broader": "xmet:4000013"
    },
    {
      "id": "xmet:4000016",
      "type": "skos:Concept",
      "prefLabel": "ortho-hydroxylation",
      "inScheme": "xmet:scheme",
      "definition": "Ortho-regioselective aromatic hydroxylation.",
      "broader": "xmet:4000013"
    },
    {
      "id": "xmet:4000017",
