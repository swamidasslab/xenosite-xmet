        "xmet:6000001"
      ],
      "relatedMatch": "xmet:6000001"
    },
    {
      "id": "xmet:6000052",
      "type": "skos:Concept",
      "prefLabel": "external-ontology alignment ambiguity",
      "inScheme": "xmet:scheme",
      "definition": "Mapping to MeSH/MOP/KEGG (or similar) is uncertain; keep XMET terms and mark alignment soft.",
      "broader": [
        "xmet:6000000",
        "xmet:6000001"
      ],
      "relatedMatch": "xmet:6000001"
    },
    {
      "id": "xmet:6000060",
      "type": "skos:Concept",
      "prefLabel": "aromatic-impact ambiguity",
      "inScheme": "xmet:scheme",
      "definition": "Impact on aromatic/conjugated systems is unclear (preserve vs dearomatize vs quinoid).",
      "broader": [
