    },
    {
      "id": "xmet:4000018",
      "type": "skos:Concept",
      "prefLabel": "benzylic hydroxylation",
      "inScheme": "xmet:scheme",
      "definition": "Hydroxylation at a carbon adjacent to an aromatic ring (benzylic). May be methyl, methylene, or methine; under hydroxylation of activated carbons.",
      "altLabel": [
        "toluene side-chain hydroxylation"
      ],
      "broader": "xmet:4000379"
    },
    {
