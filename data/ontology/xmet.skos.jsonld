        "adduct conjugation"
      ],
      "broader": "xmet:4000011"
    },
    {
      "id": "xmet:4000268",
      "type": "skos:Concept",
      "prefLabel": "protein adduct formation",
      "inScheme": "xmet:scheme",
      "definition": "Covalent adduct formation with protein nucleophiles. Often suggested by soft-electrophile / GSH-trapping evidence.",
      "altLabel": [
