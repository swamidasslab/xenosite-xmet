        "xmet:6000001"
      ],
      "relatedMatch": "xmet:6000001"
    },
    {
      "id": "xmet:6000061",
      "type": "skos:Concept",
      "prefLabel": "electrophile-role ambiguity",
      "inScheme": "xmet:scheme",
      "definition": "Whether the step generates or consumes an electrophile is unclear.",
      "broader": [
        "xmet:6000000",
        "xmet:6000001"
      ],
      "relatedMatch": "xmet:6000001"
    },
    {
      "id": "xmet:6000070",
      "type": "skos:Concept",
      "prefLabel": "provenance underspecification",
      "inScheme": "xmet:scheme",
      "definition": "Evidence source/tag provenance is missing (no structural match and no caller tags).",
      "broader": "xmet:6000000"
    },
