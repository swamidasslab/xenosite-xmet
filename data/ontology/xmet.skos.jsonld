      "broader": "xmet:7800000"
    },
    {
      "id": "xmet:7900000",
      "type": "skos:Concept",
      "prefLabel": "pathway-step role",
      "inScheme": "xmet:scheme",
      "definition": "Cross-cutting spine: role of this step in a multi-step metabolic path.",
      "broader": "xmet:1700000"
    },
    {
      "id": "xmet:7900001",
      "type": "skos:Concept",
      "prefLabel": "direct one-step transformation",
      "inScheme": "xmet:scheme",
      "definition": "Observed product arises in a single metabolic step from the named parent.",
      "broader": "xmet:7900000",
      "relatedMatch": "xmet:0000307"
    },
    {
      "id": "xmet:7900002",
      "type": "skos:Concept",
      "prefLabel": "multi-step pathway member",
      "inScheme": "xmet:scheme",
      "definition": "Step participates in a path of depth ≥ 2 (e.g. two- or three-step quinone formation).",
      "broader": "xmet:7900000",
      "relatedMatch": [
        "xmet:0000300",
        "xmet:0000308",
        "xmet:0000309"
      ]
    },
    {
      "id": "xmet:7900003",
      "type": "skos:Concept",
      "prefLabel": "preparatory intermediate step",
      "inScheme": "xmet:scheme",
      "definition": "Intermediate that enables a subsequent defining step (e.g. hydroxylation before quinone formation).",
      "broader": "xmet:7900000",
      "relatedMatch": [
        "xmet:0000308",
        "xmet:0000309"
      ]
    },
    {
      "id": "xmet:7900004",
