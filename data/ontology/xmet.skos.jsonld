    },
    {
      "id": "xmet:4000066",
      "type": "skos:Concept",
      "prefLabel": "one-step",
      "inScheme": "xmet:scheme",
      "definition": "Descriptor: transformation counted as a single formal metabolic step. For quinone-like species formation, the elementary-plan dependency cone into terminating dehydrogenation has size 1 (DH alone — both quinoid ends already present). Free co-occurring plan steps that do not precede DH do not deepen this count.",
      "altLabel": [
        "1-step",
        "single-step",
        "one-step transformation",
        "one-step quinone-like species formation",
        "1-step quinone-like species formation",
        "direct quinone-like species formation",
        "one-step quinone formation"
      ],
      "broader": "xmet:4000393"
    },
    {
      "id": "xmet:4000067",
      "type": "skos:Concept",
      "prefLabel": "two-step",
      "inScheme": "xmet:scheme",
      "definition": "Descriptor: transformation counted as two formal metabolic steps. For quinone-like species formation, the dependency cone into terminating dehydrogenation has size 2 — one preparatory elementary step that precedes DH, then DH (prep typically hydroxylation or oxidative dehalogenation).",
      "altLabel": [
        "2-step",
        "two-step transformation",
        "two-step quinone-like species formation",
        "2-step quinone-like species formation",
        "two-step quinone formation"
      ],
      "broader": "xmet:4000393"
    },
    {
      "id": "xmet:4000068",
      "type": "skos:Concept",
      "prefLabel": "three-step",
      "inScheme": "xmet:scheme",
      "definition": "Descriptor: transformation counted as three or more formal metabolic steps. For quinone-like species formation, the dependency cone into terminating dehydrogenation has size ≥3 — two (or more) preparatory elementary steps that precede DH, then DH.",
      "altLabel": [
        "3-step",
        "three-or-more-step",
        "three-step transformation",
        "three-step quinone-like species formation",
        "3-step quinone-like species formation",
        "three-step quinone formation"
      ],
      "broader": "xmet:4000393"
    },
