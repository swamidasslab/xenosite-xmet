xmet:4000387 a skos:Concept ;
  skos:prefLabel "charged nitro N–O cleavage" ;
  skos:definition "N–O cleavage of a charged nitro species." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000313 .

xmet:4000388 a skos:Concept ;
  skos:prefLabel "nitro-anion N–O cleavage" ;
  skos:definition "N–O cleavage of a nitro anion." ;
