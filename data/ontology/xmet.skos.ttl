  skos:inScheme xmet:scheme ;
  skos:altLabel "alkyl hydroxylation" ;
  skos:broader xmet:0000100 ;
  skos:relatedMatch xmet:7800002 .

xmet:0000103 a skos:Concept ;
  skos:prefLabel "para-hydroxylation" ;
  skos:definition "Aromatic hydroxylation at the para position of a substituted benzene." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:0000101 .

xmet:0000104 a skos:Concept ;
  skos:prefLabel "ortho-hydroxylation" ;
  skos:definition "ortho-hydroxylation: xenobiotic-metabolism term under aromatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
