xmet:0000307 a skos:Concept ;
  skos:prefLabel "one-step quinone formation" ;
  skos:definition "Quinone species (quinone, quinone-imine, quinone-methide, or imine-methide) whose elementary-plan dependency cone into terminating dehydrogenation has size 1 (DH alone — both quinoid ends already present). Free co-occurring plan steps that do not precede DH (e.g. dealkylation with empty precedes) do not deepen this count (quinone-formation / Rainbow papers)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "1-step quinone formation" ;
  skos:altLabel "direct quinone formation" ;
  skos:broader xmet:0000300 ;
  skos:relatedMatch xmet:7900001 .

xmet:0000308 a skos:Concept ;
  skos:prefLabel "two-step quinone formation" ;
  skos:definition "Quinone species whose dependency cone into terminating dehydrogenation has size 2 — one preparatory elementary step that precedes DH via the plan's precedes edges (installs a WillAdd oxygen), then DH. Prep in the cone is typically hydroxylation or oxidative dehalogenation; free dealkylation that does not precede DH is tagged separately and does not count toward depth. E.g. phenol → p-benzoquinone (OH ≺ DH)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "2-step quinone formation" ;
  skos:broader xmet:0000300 ;
  skos:relatedMatch xmet:7900002 ;
  skos:relatedMatch xmet:7900003 ;
  skos:relatedMatch xmet:6000040 .

xmet:0000309 a skos:Concept ;
  skos:prefLabel "three-step quinone formation" ;
  skos:definition "Quinone species whose dependency cone into terminating dehydrogenation has size ≥3 — two (or more) preparatory elementary steps that precede DH, then DH. E.g. benzene → p-benzoquinone (OH ≺ DH and OH ≺ DH). Raw plan length is not used; free unrelated steps elsewhere on the molecule do not deepen the cone." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "3-step quinone formation" ;
  skos:broader xmet:0000300 ;
  skos:relatedMatch xmet:7900002 ;
  skos:relatedMatch xmet:7900003 ;
  skos:relatedMatch xmet:6000040 .

