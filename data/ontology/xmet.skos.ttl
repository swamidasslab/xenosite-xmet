xmet:4000173 a skos:Concept ;
  skos:prefLabel "quinone-like glutathionation" ;
  skos:definition "Quinone-like (quinoid) species: two distinct sites on an aromatic system are oxidized/dehydrogenated so the ring collapses into a non-aromatic conjugated system. Covers classical quinones, quinone-imines, quinone-methides, and imine-methides. Forest “QuinoneFormation” uses this broad sense; the narrower classical quinone term sits underneath. GSH (or related thiol) conjugate addition at a quinoid electrophile." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "quinoid glutathionation" ;
  skos:altLabel "quinone glutathionation" ;
  skos:altLabel "GSH addition to quinone-like species" ;
