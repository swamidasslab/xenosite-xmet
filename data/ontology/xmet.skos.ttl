xmet:2300012 a skos:Concept ;
  skos:prefLabel "prodrug" ;
  skos:definition "Parent administered in inactive/less-active form requiring metabolic activation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2300000 ;
  skos:relatedMatch xmet:1400127 .

xmet:2300014 a skos:Concept ;
  skos:prefLabel "active parent" ;
  skos:definition "Parent compound that is pharmacologically active as administered." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "active parent drug" ;
  skos:broader xmet:2300000 ;
  skos:relatedMatch xmet:2400010 .

xmet:2300015 a skos:Concept ;
  skos:prefLabel "inactive parent" ;
  skos:definition "Parent that is inactive until metabolized (typical prodrug parent)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2300000 .

xmet:2300016 a skos:Concept ;
  skos:prefLabel "equipotent metabolite" ;
  skos:definition "Metabolite with activity comparable to the parent." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2300000 .

xmet:2300017 a skos:Concept ;
  skos:prefLabel "more active metabolite" ;
  skos:definition "Metabolite more active than the parent." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2300000 .

xmet:2300018 a skos:Concept ;
  skos:prefLabel "less active metabolite" ;
  skos:definition "Metabolite less active than the parent." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2300000 .

xmet:2300019 a skos:Concept ;
  skos:prefLabel "toxicophore-bearing metabolite" ;
  skos:definition "Metabolite carrying a toxicophore (activity framed as toxicity)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2300000 .

xmet:2400000 a skos:Concept ;
  skos:prefLabel "annotation about" ;
  skos:definition "Which entity a tag is about: parent xenobiotic, metabolite product, or the reaction/transformation itself." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "assertion about" ;
  skos:altLabel "tag target" ;
  skos:broader xmet:0000000 .

xmet:2400010 a skos:Concept ;
  skos:prefLabel "about parent" ;
  skos:definition "Tag describes the parent / reactant xenobiotic." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "parent-associated" ;
  skos:altLabel "about reactant" ;
  skos:broader xmet:2400000 ;
  skos:relatedMatch xmet:2300014 .

xmet:2400011 a skos:Concept ;
  skos:prefLabel "about product" ;
  skos:definition "Tag describes the metabolite product." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "product-associated" ;
  skos:altLabel "about metabolite" ;
  skos:broader xmet:2400000 ;
  skos:relatedMatch xmet:2300010 ;
  skos:relatedMatch xmet:1500010 .

xmet:2400012 a skos:Concept ;
  skos:prefLabel "about reaction" ;
  skos:definition "Tag describes the transformation / reaction event itself." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "reaction-associated" ;
  skos:altLabel "about transformation" ;
  skos:broader xmet:2400000 ;
  skos:relatedMatch xmet:0000100 .

xmet:2400013 a skos:Concept ;
  skos:prefLabel "about site on parent" ;
  skos:definition "Tag localizes a site on the parent structure." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2400000 ;
  skos:relatedMatch xmet:1400010 .

xmet:2400014 a skos:Concept ;
  skos:prefLabel "about site on product" ;
  skos:definition "Tag localizes a feature on the product structure." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2400000 .

xmet:2400015 a skos:Concept ;
  skos:prefLabel "about pathway" ;
  skos:definition "Tag describes multi-step pathway context rather than a single edge." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:2400000 .

xmet:2500000 a skos:Concept ;
  skos:prefLabel "metabolite product family" ;
  skos:definition "Stable or ordinary metabolite product classes (conjugates, oxygenated products, dealkylation products, …). Distinct from reactive / trapping-prone species." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "metabolite_product_family" ;
  skos:altLabel "metabolite product" ;
  skos:altLabel "product class" ;
  skos:broader xmet:0000000 .

xmet:6000000 a skos:Concept ;
  skos:prefLabel "ambiguity and underspecification" ;
  skos:definition "Cross-cutting spine for incomplete, conflicting, or underdetermined naming evidence. Prefer specific ambiguity subtypes; tag alongside positive terms rather than replacing them." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:0000000 .

xmet:6000001 a skos:Concept ;
  skos:prefLabel "ambiguous reaction" ;
  skos:definition "Broad flag: more than one incompatible reading remains open." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "underspecified reaction" ;
  skos:broader xmet:6000000 .

xmet:6000010 a skos:Concept ;
  skos:prefLabel "site-of-metabolism ambiguity" ;
  skos:definition "Which atom or bond is the SOM is not uniquely determined." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 .

xmet:6000011 a skos:Concept ;
  skos:prefLabel "regiochemical ambiguity" ;
  skos:definition "Multiple regioisomeric sites remain plausible." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000010 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000012 a skos:Concept ;
  skos:prefLabel "stereochemical ambiguity" ;
  skos:definition "Stereo outcome (or stereo of the site) is not specified." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000010 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000020 a skos:Concept ;
  skos:prefLabel "reaction-type ambiguity" ;
  skos:definition "Multiple reaction-type labels remain compatible with the evidence." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 .

xmet:6000021 a skos:Concept ;
  skos:prefLabel "competing-type ambiguity" ;
  skos:definition "Two or more named types actively compete (e.g. epoxidation vs aromatic hydroxylation via arene oxide)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000020 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000022 a skos:Concept ;
  skos:prefLabel "mechanism ambiguity" ;
  skos:definition "Overall type may be clear but the mechanistic path is not (e.g. NIH-shift vs direct insertion)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000020 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000030 a skos:Concept ;
  skos:prefLabel "metabolite-structure underspecification" ;
  skos:definition "Product structure is incomplete (missing stereo, tautomer, or connectivity detail)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 .

xmet:6000031 a skos:Concept ;
  skos:prefLabel "atom-mapping underspecification" ;
  skos:definition "Atom map is missing, partial, or inconsistent, blocking site-level tags." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000030 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000032 a skos:Concept ;
  skos:prefLabel "formula-only evidence" ;
  skos:definition "Only formula/delta evidence is available; connectivity change is not grounded." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000030 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000040 a skos:Concept ;
  skos:prefLabel "pathway-depth ambiguity" ;
  skos:definition "Unclear whether the observed change is one-step or requires intermediates." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:relatedMatch xmet:0000308 ;
  skos:relatedMatch xmet:0000309 .

xmet:6000041 a skos:Concept ;
  skos:prefLabel "intermediate underspecification" ;
  skos:definition "A multi-step path is implied but intermediate structures are not specified." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000040 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000050 a skos:Concept ;
  skos:prefLabel "phase ambiguity" ;
  skos:definition "Unclear whether the step is best typed as phase I, phase II, or neither." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 .

xmet:6000051 a skos:Concept ;
  skos:prefLabel "forest-map correspondence ambiguity" ;
  skos:definition "Chemist typing and Metabolic Forest rule/pattern correspondence are unresolved or conflicting." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000001 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000052 a skos:Concept ;
  skos:prefLabel "external-ontology alignment ambiguity" ;
  skos:definition "Mapping to MeSH/MOP/KEGG (or similar) is uncertain; keep XMET terms and mark alignment soft." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000001 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000060 a skos:Concept ;
  skos:prefLabel "aromatic-impact ambiguity" ;
  skos:definition "Impact on aromatic/conjugated systems is unclear (preserve vs dearomatize vs quinoid)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000001 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000061 a skos:Concept ;
  skos:prefLabel "electrophile-role ambiguity" ;
  skos:definition "Whether the step generates or consumes an electrophile is unclear." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 ;
  skos:broader xmet:6000001 ;
  skos:relatedMatch xmet:6000001 .

xmet:6000070 a skos:Concept ;
  skos:prefLabel "provenance underspecification" ;
  skos:definition "Evidence source/tag provenance is missing (no structural match and no caller tags)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:6000000 .

xmet:6000099 a skos:Concept ;
  skos:prefLabel "fully specified" ;
  skos:definition "No outstanding ambiguity flags for the dimensions under consideration." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "unambiguous naming" ;
  skos:broader xmet:6000000 .

xmet:7000000 a skos:Concept ;
  skos:prefLabel "redox polarity" ;
  skos:definition "Cross-cutting spine: net redox character of the transformation, independent of named reaction type." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1700000 .

xmet:7000001 a skos:Concept ;
  skos:prefLabel "net oxidation" ;
  skos:definition "Net loss of electrons / gain of oxygen or unsaturation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7000000 ;
  skos:relatedMatch xmet:0000100 ;
  skos:relatedMatch xmet:0000110 ;
  skos:relatedMatch xmet:0000200 ;
  skos:relatedMatch xmet:0000012 ;
  skos:relatedMatch xmet:0000300 .

xmet:7000002 a skos:Concept ;
  skos:prefLabel "net reduction" ;
  skos:definition "Net gain of electrons / loss of oxygen or gain of saturation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7000000 ;
  skos:relatedMatch xmet:0000014 ;
  skos:relatedMatch xmet:0000500 .

xmet:7000003 a skos:Concept ;
  skos:prefLabel "redox-neutral" ;
  skos:definition "No net redox change (e.g. many conjugations, tautomerizations, hydrolyses)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7000000 ;
  skos:relatedMatch xmet:0000013 ;
  skos:relatedMatch xmet:0001000 ;
  skos:relatedMatch xmet:0001030 ;
  skos:relatedMatch xmet:0002000 .

xmet:7000004 a skos:Concept ;
  skos:prefLabel "redox polarity unspecified" ;
  skos:definition "Redox polarity not determined from available evidence." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7000000 .

xmet:7100000 a skos:Concept ;
  skos:prefLabel "site atom class" ;
  skos:definition "Cross-cutting spine: principal element class at the site of metabolism." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "site_atom_class" ;
  skos:broader xmet:1600000 .

xmet:7100001 a skos:Concept ;
  skos:prefLabel "carbon site" ;
  skos:definition "Primary SOM involves carbon." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7100000 ;
  skos:relatedMatch xmet:0000100 .

xmet:7100002 a skos:Concept ;
  skos:prefLabel "nitrogen site" ;
  skos:definition "Primary SOM involves nitrogen (lone pair or C–N)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7100000 ;
  skos:relatedMatch xmet:0000201 .

xmet:7100003 a skos:Concept ;
  skos:prefLabel "oxygen site" ;
  skos:definition "Primary SOM involves oxygen (lone pair or C–O)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7100000 ;
  skos:relatedMatch xmet:0000202 .

xmet:7100004 a skos:Concept ;
  skos:prefLabel "sulfur site" ;
  skos:definition "Primary SOM involves sulfur." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7100000 ;
  skos:relatedMatch xmet:0000203 .

xmet:7100005 a skos:Concept ;
  skos:prefLabel "halogen site" ;
  skos:definition "Primary SOM involves halogen." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7100000 ;
  skos:relatedMatch xmet:0000210 .

xmet:7100006 a skos:Concept ;
  skos:prefLabel "phosphorus site" ;
  skos:definition "Primary SOM involves phosphorus." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7100000 .

xmet:7100007 a skos:Concept ;
  skos:prefLabel "multi-element site" ;
  skos:definition "SOM spans more than one heavy-element class (e.g. C–X cleavage)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7100000 ;
  skos:relatedMatch xmet:0000200 ;
  skos:relatedMatch xmet:0000201 ;
  skos:relatedMatch xmet:0000202 ;
  skos:relatedMatch xmet:0000203 .

xmet:7100008 a skos:Concept ;
  skos:prefLabel "site atom class unspecified" ;
  skos:definition "Site element class not asserted." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7100000 .

xmet:7200000 a skos:Concept ;
  skos:prefLabel "bond-edit topology" ;
  skos:definition "Cross-cutting spine: graph-edit shape of the transformation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1700000 .

xmet:7200001 a skos:Concept ;
  skos:prefLabel "atom addition" ;
  skos:definition "Heavy atom(s) added without bond cleavage of the scaffold (e.g. hydroxylation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7200000 ;
  skos:relatedMatch xmet:0000100 .

xmet:7200002 a skos:Concept ;
  skos:prefLabel "bond cleavage" ;
  skos:definition "A heavy-atom bond is broken (dealkylation, hydrolysis, dehalogenation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7200000 ;
  skos:relatedMatch xmet:0000200 ;
  skos:relatedMatch xmet:0000210 ;
  skos:relatedMatch xmet:0000013 .

xmet:7200003 a skos:Concept ;
  skos:prefLabel "bond order change" ;
  skos:definition "Bond order increases or decreases without heavy-atom count change (dehydrogenation, hydrogenation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7200000 ;
  skos:relatedMatch xmet:0000012 ;
  skos:relatedMatch xmet:0000500 .

xmet:7200004 a skos:Concept ;
  skos:prefLabel "substitution" ;
  skos:definition "One substituent replaces another at a site." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7200000 .

xmet:7200005 a skos:Concept ;
  skos:prefLabel "rearrangement topology" ;
  skos:definition "Atom connectivity is reshuffled (NIH shift, acyl migration, skeletal rearrangement)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7200000 ;
  skos:relatedMatch xmet:0002000 .

xmet:7200006 a skos:Concept ;
  skos:prefLabel "ring closure" ;
  skos:definition "A new ring is formed." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7200000 ;
  skos:relatedMatch xmet:0000110 .

xmet:7200007 a skos:Concept ;
  skos:prefLabel "ring opening topology" ;
  skos:definition "A ring bond is opened." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7200000 .

xmet:7200008 a skos:Concept ;
  skos:prefLabel "bond-edit topology unspecified" ;
  skos:definition "Graph-edit class not asserted." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7200000 .

xmet:7300000 a skos:Concept ;
  skos:prefLabel "metabolite cardinality" ;
  skos:definition "Cross-cutting spine: whether the reaction yields one observed metabolite or fragments into more." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1700000 .

xmet:7300001 a skos:Concept ;
  skos:prefLabel "single-metabolite transformation" ;
  skos:definition "One principal product retains the scaffold (Rainbow stable-oxygenation style outcome)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7300000 ;
  skos:relatedMatch xmet:0000100 .

xmet:7300002 a skos:Concept ;
  skos:prefLabel "fragmenting transformation" ;
  skos:definition "Scaffold cleavage yields two (or more) products (dealkylation, hydrolysis)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7300000 ;
  skos:relatedMatch xmet:0000200 ;
  skos:relatedMatch xmet:0000013 .

xmet:7300003 a skos:Concept ;
  skos:prefLabel "metabolite cardinality unspecified" ;
  skos:definition "Whether the reaction fragments is not asserted." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7300000 .

xmet:7400000 a skos:Concept ;
  skos:prefLabel "oxygenation outcome" ;
  skos:definition "Cross-cutting chemist spine for oxygenation fate: stable oxygen addition versus oxygen-triggered cleavage. Distinct from the Metabolic Forest map nodes." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1700000 .

xmet:7400001 a skos:Concept ;
  skos:prefLabel "stable oxygen addition" ;
  skos:definition "Oxygen is retained in a single observable oxygenated metabolite." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7400000 ;
  skos:relatedMatch xmet:0000100 ;
  skos:relatedMatch xmet:0000110 .

xmet:7400002 a skos:Concept ;
  skos:prefLabel "oxygen-triggered cleavage" ;
  skos:definition "Oxygenation precipitates heavy-bond cleavage (unstable oxygenation outcome)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7400000 ;
  skos:relatedMatch xmet:0000200 ;
  skos:relatedMatch xmet:0000210 .

xmet:7400003 a skos:Concept ;
  skos:prefLabel "non-oxygenative transformation" ;
  skos:definition "No oxygenation step defines the outcome." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7400000 ;
  skos:relatedMatch xmet:0000012 ;
  skos:relatedMatch xmet:0000014 .

xmet:7400004 a skos:Concept ;
  skos:prefLabel "oxygenation outcome unspecified" ;
  skos:definition "Oxygenation fate not asserted." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7400000 .

xmet:7500000 a skos:Concept ;
  skos:prefLabel "electrophile role" ;
  skos:definition "Cross-cutting spine: relationship of the step to electrophilic reactivity / soft-hard capture." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "electrophile_role" ;
  skos:broader xmet:1500000 .

xmet:7500001 a skos:Concept ;
  skos:prefLabel "electrophile generation" ;
  skos:definition "Forms or unmasks an electrophilic metabolite." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7500000 ;
  skos:relatedMatch xmet:0000300 ;
  skos:relatedMatch xmet:0003000 .

xmet:7500002 a skos:Concept ;
  skos:prefLabel "electrophile consumption" ;
  skos:definition "Captures or quenches an electrophile (e.g. GSH conjugation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7500000 ;
  skos:relatedMatch xmet:0001030 ;
  skos:relatedMatch xmet:0001031 ;
  skos:relatedMatch xmet:0003001 .

xmet:7500003 a skos:Concept ;
  skos:prefLabel "nucleophile exposure" ;
  skos:definition "Exposes a nucleophilic handle for later conjugation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7500000 ;
  skos:relatedMatch xmet:0001000 .

xmet:7500004 a skos:Concept ;
  skos:prefLabel "reactivity-neutral step" ;
  skos:definition "Neither generates nor consumes a notable electrophile in the usual sense." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7500000 ;
  skos:relatedMatch xmet:0003001 .

xmet:7500005 a skos:Concept ;
  skos:prefLabel "electrophile role unspecified" ;
  skos:definition "Electrophile role not asserted." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7500000 .

xmet:7600000 a skos:Concept ;
  skos:prefLabel "ring fate" ;
  skos:definition "Cross-cutting spine: effect on ring systems." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1700000 .

xmet:7600001 a skos:Concept ;
  skos:prefLabel "ring preserved" ;
  skos:definition "Existing rings unchanged in membership." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7600000 ;
  skos:relatedMatch xmet:0004001 .

xmet:7600002 a skos:Concept ;
  skos:prefLabel "ring opened" ;
  skos:definition "A ring is opened." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7600000 .

xmet:7600003 a skos:Concept ;
  skos:prefLabel "ring formed" ;
  skos:definition "A new ring is formed (e.g. epoxide)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7600000 ;
  skos:relatedMatch xmet:0000110 .

xmet:7600004 a skos:Concept ;
  skos:prefLabel "ring expanded" ;
  skos:definition "Ring size increases." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7600000 .

xmet:7600005 a skos:Concept ;
  skos:prefLabel "ring contracted" ;
  skos:definition "Ring size decreases." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7600000 .

xmet:7600006 a skos:Concept ;
  skos:prefLabel "ring fate unspecified" ;
  skos:definition "Ring fate not asserted." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7600000 .

xmet:7700000 a skos:Concept ;
  skos:prefLabel "formula-delta class" ;
  skos:definition "Cross-cutting spine keyed to heavy-atom formula change; highly automatable from reactant/product formulas." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1700000 .

xmet:7700001 a skos:Concept ;
  skos:prefLabel "oxygen gain" ;
  skos:definition "Net +O (and no other heavy-atom change, unless further specialized)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "+O" ;
  skos:broader xmet:7700000 ;
  skos:relatedMatch xmet:0000100 ;
  skos:relatedMatch xmet:0000110 .

xmet:7700002 a skos:Concept ;
  skos:prefLabel "oxygen loss" ;
  skos:definition "Net −O." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "-O" ;
  skos:broader xmet:7700000 .

xmet:7700003 a skos:Concept ;
  skos:prefLabel "hydrogenation delta" ;
  skos:definition "Net +H₂ equivalent without other heavy-atom change (often inferred with bond-order change)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7700000 ;
  skos:relatedMatch xmet:0000500 .

xmet:7700004 a skos:Concept ;
  skos:prefLabel "dehydrogenation delta" ;
  skos:definition "Net −H₂ equivalent without other heavy-atom change." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7700000 ;
  skos:relatedMatch xmet:0000012 .

xmet:7700005 a skos:Concept ;
  skos:prefLabel "water addition delta" ;
  skos:definition "Net +H₂O." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "+H2O" ;
  skos:altLabel "hydration delta" ;
  skos:broader xmet:7700000 ;
  skos:relatedMatch xmet:0000013 .

xmet:7700006 a skos:Concept ;
  skos:prefLabel "water loss delta" ;
  skos:definition "Net −H₂O." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "-H2O" ;
  skos:broader xmet:7700000 .

xmet:7700007 a skos:Concept ;
  skos:prefLabel "alkyl loss delta" ;
  skos:definition "Net loss of carbon(s) consistent with dealkylation/fragmentation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7700000 .

xmet:7700008 a skos:Concept ;
  skos:prefLabel "conjugate gain delta" ;
  skos:definition "Net gain matching a conjugation adduct formula class (when known)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7700000 ;
  skos:relatedMatch xmet:0001000 .

xmet:7700009 a skos:Concept ;
