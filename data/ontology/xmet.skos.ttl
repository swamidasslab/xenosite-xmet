xmet:0000300 a skos:Concept ;
  skos:prefLabel "quinone formation" ;
  skos:definition "Formation of a quinone species by metabolic oxidation (quinone, quinone-imine, quinone-methide, or imine-methide). Pathway depth is the dependency cone into terminating dehydrogenation (precedes-ancestors ∪ DH), not raw elementary-plan length — free unrelated steps do not deepen the count. From the quinone-formation and Metabolic Forest papers; under dehydrogenation in the Forest-mapped Phase I hierarchy." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "quinonation" ;
  skos:altLabel "quinone species formation" ;
