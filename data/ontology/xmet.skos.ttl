xmet:4000224 a skos:Concept ;
  skos:prefLabel "demethylation mass shift (−14 Da)" ;
  skos:definition "Nominal −14 Da (loss of CH₂). Suggests N-/O-/S-demethylation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "demethylation mass shift" ;
  skos:altLabel "-CH2" ;
  skos:altLabel "−14 Da" ;
  skos:altLabel "demethylation delta" ;
  skos:broader xmet:4000221 .

xmet:4000225 a skos:Concept ;
  skos:prefLabel "deethylation mass shift (−28 Da)" ;
  skos:definition "Nominal −28 Da (loss of C₂H₄). Suggests deethylation (N-/O-)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "deethylation mass shift" ;
  skos:altLabel "-C2H4" ;
  skos:altLabel "−28 Da" ;
  skos:altLabel "deethylation delta" ;
  skos:broader xmet:4000221 .

xmet:4000226 a skos:Concept ;
  skos:prefLabel "glucuronide mass shift (+176 Da)" ;
  skos:definition "Nominal +176 Da for glucuronide conjugation. Suggests glucuronidation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "glucuronide mass shift" ;
  skos:altLabel "+C6H8O6" ;
  skos:altLabel "+176 Da" ;
  skos:altLabel "GlcA mass shift" ;
  skos:broader xmet:4000221 .

xmet:4000227 a skos:Concept ;
  skos:prefLabel "sulfate mass shift (+80 Da)" ;
  skos:definition "Nominal +80 Da for sulfate conjugation. Suggests sulfation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "sulfate mass shift" ;
  skos:altLabel "+SO3" ;
  skos:altLabel "+80 Da" ;
  skos:altLabel "sulfate conjugation mass shift" ;
  skos:broader xmet:4000221 .

xmet:4000228 a skos:Concept ;
  skos:prefLabel "GSH mass shift (+305 Da)" ;
  skos:definition "Nominal +305 Da (glutathione conjugation / adduct). Suggests glutathione conjugation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "GSH mass shift" ;
  skos:altLabel "+GSH" ;
  skos:altLabel "+305 Da" ;
  skos:altLabel "glutathione mass shift" ;
  skos:broader xmet:4000221 .

xmet:4000229 a skos:Concept ;
  skos:prefLabel "leaving group" ;
  skos:definition "Fragment or moiety that departs in cleavage / substitution / dealkylation / hydrolysis. Pragmatic stop-word filter for metabolite annotation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "leaving_group" ;
  skos:altLabel "departing group" ;
  skos:broader xmet:4000263 .

xmet:4000230 a skos:Concept ;
  skos:prefLabel "methyl leaving group" ;
  skos:definition "Methyl fragment departing (typical N-/O-demethylation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "CH3 leaving group" ;
  skos:broader xmet:4000252 .

xmet:4000231 a skos:Concept ;
  skos:prefLabel "ethyl leaving group" ;
  skos:definition "Ethyl fragment departing (typical N-/O-deethylation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000252 .

xmet:4000232 a skos:Concept ;
  skos:prefLabel "propyl leaving group" ;
  skos:definition "Propyl fragment departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000252 .

xmet:4000233 a skos:Concept ;
  skos:prefLabel "isopropyl leaving group" ;
  skos:definition "Isopropyl fragment departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000252 .

xmet:4000234 a skos:Concept ;
  skos:prefLabel "benzyl leaving group" ;
  skos:definition "Benzyl fragment departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000252 .

xmet:4000235 a skos:Concept ;
  skos:prefLabel "allyl leaving group" ;
  skos:definition "Allyl fragment departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000252 .

xmet:4000236 a skos:Concept ;
  skos:prefLabel "halide leaving group" ;
  skos:definition "Halide ion departing (fluoride, chloride, bromide, iodide)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "halogen leaving group" ;
  skos:broader xmet:4000229 .

xmet:4000237 a skos:Concept ;
  skos:prefLabel "fluoride leaving group" ;
  skos:definition "Fluoride departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000236 .

xmet:4000238 a skos:Concept ;
  skos:prefLabel "chloride leaving group" ;
  skos:definition "Chloride departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000236 .

xmet:4000239 a skos:Concept ;
  skos:prefLabel "bromide leaving group" ;
  skos:definition "Bromide departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000236 .

xmet:4000240 a skos:Concept ;
  skos:prefLabel "iodide leaving group" ;
  skos:definition "Iodide departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000236 .

xmet:4000241 a skos:Concept ;
  skos:prefLabel "alcohol leaving fragment" ;
  skos:definition "Alcohol / alkanol-equivalent fragment released as a coproduct (e.g. methanol from demethylation to alcohol level, ethanol from deethylation), or from ether cleavage / hydrolysis." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000359 .

xmet:4000242 a skos:Concept ;
  skos:prefLabel "amine leaving fragment" ;
  skos:definition "Amine fragment from amide/urea hydrolysis or N-dealkylation path." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000360 .

xmet:4000243 a skos:Concept ;
  skos:prefLabel "phenol leaving fragment" ;
  skos:definition "Phenol / phenoxide fragment departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000359 .

xmet:4000244 a skos:Concept ;
  skos:prefLabel "thiol leaving fragment" ;
  skos:definition "Thiol / thiolate fragment departing." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000361 .

xmet:4000245 a skos:Concept ;
  skos:prefLabel "carboxylate leaving group" ;
  skos:definition "Carboxylate departing (e.g. ester hydrolysis)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000359 .

xmet:4000246 a skos:Concept ;
  skos:prefLabel "phosphate leaving group" ;
  skos:definition "Phosphate / phosphoryl leaving group." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000359 .

xmet:4000247 a skos:Concept ;
  skos:prefLabel "sulfate leaving group" ;
  skos:definition "Sulfate leaving group." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000359 .

xmet:4000248 a skos:Concept ;
  skos:prefLabel "water leaving group" ;
  skos:definition "Water departing (dehydration / condensation reverse)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000359 .

xmet:4000249 a skos:Concept ;
  skos:prefLabel "hydrogen leaving group" ;
  skos:definition "Hydride / proton framing for dehydrogenation ends." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000362 .

xmet:4000250 a skos:Concept ;
  skos:prefLabel "formaldehyde leaving fragment" ;
  skos:definition "Formaldehyde-equivalent leaving fragment from demethylation / carbinolamine cleavage. A specialized aldehyde leaving group." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000396 .

xmet:4000251 a skos:Concept ;
  skos:prefLabel "acetaldehyde leaving fragment" ;
  skos:definition "Acetaldehyde-equivalent leaving fragment from deethylation. A specialized aldehyde leaving group." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000396 .

xmet:4000252 a skos:Concept ;
  skos:prefLabel "small alkyl leaving group" ;
  skos:definition "Small alkyl (or closely related unsaturated alkyl) carbon fragment that departs (methyl, ethyl, propyl, isopropyl, benzyl, allyl, …)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000229 .

xmet:4000253 a skos:Concept ;
  skos:prefLabel "aryl leaving group" ;
  skos:definition "Aryl fragment departing (less common)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000229 .

xmet:4000254 a skos:Concept ;
  skos:prefLabel "mesylate leaving group" ;
  skos:definition "Mesylate / sulfonate ester leaving group." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000262 .

xmet:4000255 a skos:Concept ;
  skos:prefLabel "tosylate leaving group" ;
  skos:definition "Tosylate leaving group." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000262 .

xmet:4000256 a skos:Concept ;
  skos:prefLabel "isocyanate leaving fragment" ;
  skos:definition "Isocyanate fragment in carbamate/urea chemistry." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000360 .

xmet:4000257 a skos:Concept ;
  skos:prefLabel "cyanide leaving group" ;
  skos:definition "Cyanide departing (nitrile hydrolysis / related)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000362 .

xmet:4000258 a skos:Concept ;
  skos:prefLabel "nitrogen gas leaving group" ;
  skos:definition "N2 departing (azo / diazo paths)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000360 .

xmet:4000259 a skos:Concept ;
  skos:prefLabel "no leaving group" ;
  skos:definition "Transformation without a discrete departing fragment." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "non-cleaving transformation" ;
  skos:broader xmet:4000229 .

xmet:4000260 a skos:Concept ;
  skos:prefLabel "carbonyl leaving fragment" ;
  skos:definition "Carbonyl-containing fragment released in cleavage or dealkylation paths. Includes aldehyde leaving groups (formaldehyde, acetaldehyde, …) and related carbonyl equivalents." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "aldehyde leaving fragment" ;
  skos:altLabel "carbonyl / aldehyde leaving fragment" ;
  skos:broader xmet:4000229 .

xmet:4000261 a skos:Concept ;
  skos:prefLabel "heteroatom or small-molecule leaving group" ;
  skos:definition "Heteroatom-centered or small inorganic/organic molecule that departs (water, hydrogen, alcohol/phenol/amine/thiol fragments, oxyanions, cyanide, …)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "heteroatom leaving group" ;
  skos:altLabel "small-molecule leaving group" ;
  skos:broader xmet:4000229 .

xmet:4000262 a skos:Concept ;
  skos:prefLabel "sulfonate leaving group" ;
  skos:definition "Sulfonate ester leaving groups (mesylate, tosylate, and related)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "sulfonate ester leaving group" ;
  skos:altLabel "activated sulfonate leaving group" ;
  skos:broader xmet:4000229 .

xmet:4000263 a skos:Concept ;
  skos:prefLabel "reaction descriptor" ;
  skos:definition "Orthogonal descriptors (leaving group, ring/aromaticity effect, cleavage, mass shift, multistep) used alongside reaction class." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "reaction_descriptor" ;
  skos:broader xmet:4000000 .

xmet:4000264 a skos:Concept ;
  skos:prefLabel "elimination" ;
  skos:definition "Elimination or excretion disposition tag for xenobiotic clearance from the organism (urine, bile, breath, …)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "elimination or excretion" ;
  skos:altLabel "excretion" ;
  skos:broader xmet:4000212 .

xmet:4000265 a skos:Concept ;
  skos:prefLabel "isoredox" ;
  skos:definition "Redox-neutral transformations (Rainbow sense). Holds hydrolysis and related water-mediated bond breaks." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "redox-neutral transformation" ;
  skos:altLabel "isoredox class" ;
  skos:broader xmet:4000213 .

xmet:4000266 a skos:Concept ;
  skos:prefLabel "transfer conjugation" ;
  skos:definition "Metabolic transfer of an endogenous moiety (glucuronide, sulfate, acetyl, methyl, amino acid, glycosyl, CoA, …) typically supporting clearance. Distinct from reactive adduct formation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "metabolic transfer conjugation" ;
  skos:altLabel "Phase II transfer conjugation" ;
  skos:broader xmet:4000011 .

xmet:4000267 a skos:Concept ;
  skos:prefLabel "adduct formation" ;
  skos:definition "Electrophile capture / macromolecular or trapping adduct formation (GSH, protein, DNA, cyanide). Distinct from transfer conjugation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "reactive-species capture conjugation" ;
  skos:altLabel "adduct conjugation" ;
  skos:broader xmet:4000011 .

xmet:4000268 a skos:Concept ;
  skos:prefLabel "protein adduct formation" ;
  skos:definition "Covalent adduct formation with protein nucleophiles. Often suggested by soft-electrophile / GSH-trapping evidence." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "protein adduct" ;
  skos:altLabel "protein binding adduct" ;
  skos:broader xmet:4000367 .

xmet:4000269 a skos:Concept ;
  skos:prefLabel "DNA adduct formation" ;
  skos:definition "Covalent adduct formation with DNA nucleophiles. Often suggested by hard-electrophile / cyanide-trapping evidence." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "DNA adduct" ;
  skos:broader xmet:4000367 .

xmet:4000270 a skos:Concept ;
  skos:prefLabel "cyanide conjugation" ;
  skos:definition "Trapping of hard electrophiles (e.g. iminium) with cyanide. Distinct from cyanide as a leaving group. Soft-suggests DNA adduct formation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "cyanide trapping" ;
  skos:altLabel "cyanide adduct formation" ;
  skos:altLabel "CN trapping" ;
  skos:broader xmet:4000366 .

xmet:4000271 a skos:Concept ;
  skos:prefLabel "skeletal rearrangement" ;
  skos:definition "Rearrangement that changes atom connectivity of the heavy-atom skeleton (sparse in xenobiotic metabolism)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000190 .

xmet:4000272 a skos:Concept ;
  skos:prefLabel "composite transformation" ;
  skos:definition "Multi-step or multi-part transformation described as a unit; constituents linked via has part / is part of." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "composite" ;
  skos:altLabel "composite pathway" ;
  skos:broader xmet:4000213 .

xmet:4000273 a skos:Concept ;
  skos:prefLabel "ring effect" ;
  skos:definition "Ring opening, closure, expansion, or contraction accompanying a reaction." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000263 .

xmet:4000274 a skos:Concept ;
  skos:prefLabel "aromaticity effect" ;
  skos:definition "Gain or loss of aromatic character accompanying a transformation (aromatization / rearomatization / dearomatization)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "aromaticity change" ;
  skos:altLabel "aromaticity descriptor" ;
  skos:broader xmet:4000263 .

xmet:4000275 a skos:Concept ;
  skos:prefLabel "cleavage" ;
  skos:definition "Directional bond-break cue: ring-opening cleavage, cleavage with leaving group, or fragmenting cleavage (≥2 metabolite products)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000263 .

xmet:4000276 a skos:Concept ;
  skos:prefLabel "ring-opening cleavage" ;
  skos:definition "Bond break that opens a ring; always with ring opening." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000275 .

xmet:4000277 a skos:Concept ;
  skos:prefLabel "cleavage with leaving group" ;
  skos:definition "One product is the retained scaffold; the other is a small/generic leaving fragment." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000275 .

xmet:4000278 a skos:Concept ;
  skos:prefLabel "fragmenting cleavage" ;
  skos:definition "Cleavage yields two or more xenobiotic-derived metabolites that each deserve product-level identity (not collapsed to leaving group)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000275 .

xmet:4000279 a skos:Concept ;
  skos:prefLabel "GSH pyroglutamate neutral loss (129 Da)" ;
  skos:definition "Characteristic MS neutral loss of ~129 Da (pyroglutamate) suggesting glutathione conjugation / GSH adduct." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "GSH pyroglutamate neutral loss" ;
  skos:altLabel "NL 129" ;
  skos:altLabel "pyroglutamate neutral loss" ;
  skos:altLabel "129 Da neutral loss" ;
  skos:broader xmet:4000228 .

xmet:4000280 a skos:Concept ;
  skos:prefLabel "cyanide mass shift (27 Da)" ;
  skos:definition "Mass cue / neutral loss of ~27 Da (HCN) suggesting cyanide conjugation / trapping." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "cyanide mass shift" ;
  skos:altLabel "NL 27" ;
  skos:altLabel "HCN neutral loss" ;
  skos:altLabel "~27 Da" ;
  skos:altLabel "cyanide neutral loss" ;
  skos:broader xmet:4000221 .

xmet:4000281 a skos:Concept ;
  skos:prefLabel "concept relation" ;
  skos:definition "Parent for the small relation vocabulary used across XMET spines." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000000 .

xmet:4000282 a skos:Concept ;
  skos:prefLabel "related to" ;
  skos:definition "Associated with; no frequency or necessity claim." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "relatedTo" ;
  skos:altLabel "xmet:relatedTo" ;
  skos:broader xmet:4000281 ;
  skos:exactMatch <https://xenosite.org/ontology/xmet/ext/skos/related> .

xmet:4000283 a skos:Concept ;
  skos:prefLabel "suggests" ;
  skos:definition "Often (but not always) associated with." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "suggests" ;
  skos:altLabel "xmet:suggests" ;
  skos:broader xmet:4000281 .

xmet:4000284 a skos:Concept ;
  skos:prefLabel "always with" ;
  skos:definition "Whenever this term applies, the target also applies (or a term under the target if it is a category root). Stronger form of suggests." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "alwaysWith" ;
  skos:altLabel "xmet:alwaysWith" ;
  skos:broader xmet:4000283 .

xmet:4000285 a skos:Concept ;
  skos:prefLabel "has part" ;
  skos:definition "Has as a constituent / part (e.g. composite has part reaction)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "hasPart" ;
  skos:altLabel "xmet:hasPart" ;
  skos:broader xmet:4000281 ;
  skos:exactMatch <https://xenosite.org/ontology/xmet/ext/dcterms/hasPart> .

xmet:4000286 a skos:Concept ;
  skos:prefLabel "is part of" ;
  skos:definition "Is a constituent / part of. Inverse of has part." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "isPartOf" ;
  skos:altLabel "xmet:isPartOf" ;
  skos:broader xmet:4000281 ;
  skos:exactMatch <https://xenosite.org/ontology/xmet/ext/dcterms/isPartOf> .

xmet:4000287 a skos:Concept ;
  skos:prefLabel "aromatic epoxidation" ;
  skos:definition "Epoxidation on an aromatic system." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "arene epoxidation" ;
  skos:altLabel "aromatic_epoxidation" ;
  skos:broader xmet:4000290 .

xmet:4000288 a skos:Concept ;
  skos:prefLabel "reductive C–halogen cleavage" ;
  skos:definition "Reductive cleavage of a carbon–halogen bond with loss of halide and retention of carbon saturation (no new C=C required)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000110 .

xmet:4000289 a skos:Concept ;
  skos:prefLabel "reductive dehalogenation to alkene" ;
  skos:definition "Reductive loss of halide accompanied by formation of a C=C bond between the halogen-bearing carbon and an adjacent carbon." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000110 .

xmet:4000290 a skos:Concept ;
  skos:prefLabel "epoxide ring formation" ;
  skos:definition "Formation of a three-membered epoxide ring from a C=C (or C=N) bond by oxygen addition." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000022 .

xmet:4000291 a skos:Concept ;
  skos:prefLabel "methine hydroxylation" ;
  skos:definition "Hydroxylation at a methine carbon (R3C–H / aromatic CH; Forest Hydroxylation/h matches [#6h1]). Carbon-class shelf under hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000012 .

xmet:4000292 a skos:Concept ;
  skos:prefLabel "methyl or methylene hydroxylation" ;
  skos:definition "Hydroxylation at a methyl or methylene carbon (RCH3 or R2CH2 → alcohol)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000012 .

xmet:4000293 a skos:Concept ;
  skos:prefLabel "hydrolytic bond cleavage" ;
  skos:definition "Hydrolysis that cleaves a bond to N, O, or S adjacent to a carbonyl (or thiocarbonyl), releasing the heteroatom fragment." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000007 .

xmet:4000294 a skos:Concept ;
  skos:prefLabel "carbonyl hydration with cleavage" ;
  skos:definition "Addition of water at a carbonyl (or thiocarbonyl) with cleavage of an adjacent heteroatom bond. A specialized hydration (and hydrolytic cleavage), not the parent of general hydration." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000204 .

xmet:4000295 a skos:Concept ;
  skos:prefLabel "epoxide hydration" ;
  skos:definition "Opening of an epoxide by water to form a 1,2-diol." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000077 .

xmet:4000296 a skos:Concept ;
  skos:prefLabel "epoxide rearrangement" ;
  skos:definition "Rearrangement accompanying epoxide opening (for example to a phenol or carbonyl)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000077 .

xmet:4000297 a skos:Concept ;
  skos:prefLabel "sulfur–oxygen zwitterion formation" ;
  skos:definition "Oxidation of sulfur to a charge-separated S⁺–O⁻ (zwitterionic) oxide." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000032 .

xmet:4000298 a skos:Concept ;
  skos:prefLabel "sulfenic acid formation" ;
  skos:definition "Oxidation of sulfur introducing an S–OH (sulfenic acid) group." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000032 .

xmet:4000299 a skos:Concept ;
  skos:prefLabel "sulfur oxo formation" ;
  skos:definition "Oxidation forming an S=O bond (sulfoxide pathway, or further to sulfone)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000032 .

xmet:4000300 a skos:Concept ;
  skos:prefLabel "peroxide reduction" ;
  skos:definition "Reductive cleavage of an O–O peroxide bond." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000101 .

xmet:4000301 a skos:Concept ;
  skos:prefLabel "thioether C–S or O–S cleavage" ;
  skos:definition "Reductive cleavage of a sulfur–carbon or sulfur–oxygen bond in a thioether or related context." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000106 .

xmet:4000302 a skos:Concept ;
  skos:prefLabel "alkane dehydrogenation" ;
  skos:definition "Dehydrogenation forming a C=C bond from an alkyl C–C context." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000395 .

xmet:4000303 a skos:Concept ;
  skos:prefLabel "sulfoxide formation by dehydrogenation" ;
  skos:definition "Dehydrogenation of an S–OH species to S=O (sulfoxide)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000006 .

xmet:4000304 a skos:Concept ;
  skos:prefLabel "alcohol dehydration" ;
  skos:definition "Loss of water from an alcohol (or related C/N–OH), yielding unsaturation or fragmentation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000113 .

xmet:4000305 a skos:Concept ;
  skos:prefLabel "beta-elimination" ;
  skos:definition "Beta-elimination of OH forming a C=C bond." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000113 .

xmet:4000306 a skos:Concept ;
  skos:prefLabel "carbonyl dehydration" ;
  skos:definition "Dehydration involving a carbonyl oxygen (loss of water-equivalent from a C=O context)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000113 .

xmet:4000307 a skos:Concept ;
  skos:prefLabel "oxidative dehalogenation to alcohol" ;
  skos:definition "Replacement of carbon-bound halogen by OH with loss of the halide." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000051 .

xmet:4000308 a skos:Concept ;
  skos:prefLabel "oxidative dehalogenation to carbonyl" ;
  skos:definition "Oxidative loss of halide from a methine halide yielding a carbonyl." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000051 .

xmet:4000309 a skos:Concept ;
  skos:prefLabel "oxidative dehalogenation to carboxylic acid" ;
  skos:definition "Oxidative loss of halide from a methylene halide yielding a carboxylic acid." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000051 .

xmet:4000310 a skos:Concept ;
  skos:prefLabel "1,2-halide migration with hydroxylation" ;
  skos:definition "Oxidative dehalogenation with 1,2-migration of halide onto an adjacent carbon and hydroxylation at the original site." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000051 .

xmet:4000311 a skos:Concept ;
  skos:prefLabel "geminal dihalide to carboxylic acid" ;
  skos:definition "Oxidative conversion of a geminal dihalide carbon to a carboxylic acid with loss of both halides." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000051 .

xmet:4000312 a skos:Concept ;
  skos:prefLabel "geminal dihalide to geminal diol" ;
  skos:definition "Oxidative conversion of a geminal dihalide to a geminal diol (hydrate) with loss of both halides." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000051 .

xmet:4000313 a skos:Concept ;
  skos:prefLabel "nitro N–O cleavage" ;
  skos:definition "Partial reduction of a nitro group by cleavage of an N–O bond (covers charged, anionic, and neutral nitro representations used in matching)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000375 .

xmet:4000314 a skos:Concept ;
  skos:prefLabel "hydroxylamine N–O cleavage" ;
  skos:definition "Reductive cleavage of the N–O bond of a hydroxylamine." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000375 .

xmet:4000315 a skos:Concept ;
  skos:prefLabel "nitroso reduction" ;
  skos:definition "Reduction of a nitroso group (N=O)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000375 .

xmet:4000316 a skos:Concept ;
  skos:prefLabel "quaternary C–heteroatom dealkylation" ;
  skos:definition "Dealkylation cleaving a quaternary carbon–heteroatom bond. Ox-state via Forest alwaysWith (alcohol-level), not hierarchy." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "quaternary C–heteroatom dealkylation to alcohol" ;
  skos:broader xmet:4000343 .

xmet:4000317 a skos:Concept ;
  skos:prefLabel "quaternary C-dealkylation" ;
  skos:definition "C-dealkylation at a quaternary carbon (oxidative C–C cleavage). Ox-state via Forest alwaysWith (alcohol-level)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "quaternary C–C dealkylation" ;
  skos:altLabel "quaternary C-dealkylation to alcohol" ;
  skos:broader xmet:4000046 .

xmet:4000318 a skos:Concept ;
  skos:prefLabel "hemiaminal collapse dealkylation" ;
  skos:definition "Dealkylation via hemiaminal/hemiacetal/hemithioacetal collapse. alwaysWith encodes aldehyde-level cleaved carbon and no discrete alkyl leaving group." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000343 .

xmet:4000319 a skos:Concept ;
  skos:prefLabel "dehydrogenation to phenol" ;
  skos:definition "A dehydrogenation path whose product site is a phenol (aromatic or phenolic C–OH), often a precursor to quinone-like oxidation in which a second site is later dehydrogenated and aromaticity collapses." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000006 .

xmet:4000320 a skos:Concept ;
  skos:prefLabel "dehydrogenation to amine" ;
  skos:definition "A dehydrogenation path whose product site is a primary or secondary amine." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000006 .

xmet:4000321 a skos:Concept ;
  skos:prefLabel "dehydrogenation to alkyl methide site" ;
  skos:definition "A dehydrogenation path whose product site is an alkyl carbon in a methide-forming context (methyl, methylene, or methine)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000006 .

xmet:4000322 a skos:Concept ;
  skos:prefLabel "conjugated-path hydrogenation" ;
  skos:definition "Hydrogenation along a conjugated bond path that adds hydrogen at the path end (including dearomatizing reductions of aromatic systems). The path end may be any atom kept in place; a carbonyl oxygen end yields the corresponding alcohol." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "dearomatizing hydrogenation" ;
  skos:altLabel "resonance-path hydrogenation" ;
  skos:broader xmet:4000090 .

xmet:4000323 a skos:Concept ;
  skos:prefLabel "arene oxide–trans-dihydrodiol pathway" ;
  skos:definition "Composite: aromatic epoxidation (arene oxide formation) followed by epoxide hydration to a trans-1,2-dihydrodiol (mEH/sEH-family chemistry)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "epoxide formation and opening to trans-diol" ;
  skos:altLabel "epoxidation–hydration to trans-dihydrodiol" ;
  skos:altLabel "arene oxide hydration pathway" ;
  skos:broader xmet:4000272 .

xmet:4000324 a skos:Concept ;
  skos:prefLabel "arene oxide–arenol conjugation pathway" ;
  skos:definition "Composite: aromatic epoxidation (arene oxide formation), rearrangement of the arene oxide to a phenol/arenol, then phenolic O-glucuronidation and/or O-sulfation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "epoxide formation and opening to trans-alcohol with conjugation" ;
  skos:altLabel "arene oxide–phenol conjugation pathway" ;
  skos:altLabel "arene oxide rearrangement then phenolic conjugation" ;
  skos:altLabel "NIH shift then phenolic conjugation" ;
  skos:broader xmet:4000272 .

xmet:4000325 a skos:Concept ;
  skos:prefLabel "diol formation" ;
  skos:definition "Formation of a 1,2-diol. Mechanism-spanning umbrella: cis routes (e.g. dioxygenase cis-dihydroxylation) and trans routes (e.g. epoxide hydration to a trans-dihydrodiol). Reaction-class term (product stereochemistry specialized below), not a descriptor facet." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "dihydroxylation" ;
  skos:altLabel "1,2-diol formation" ;
  skos:broader xmet:4000213 .

xmet:4000326 a skos:Concept ;
  skos:prefLabel "trans-diol formation" ;
  skos:definition "Formation of a trans-1,2-diol (trans-dihydrodiol). Product stereochemistry class under diol formation; often produced by epoxide hydration but not defined as a subtype of it." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "trans-dihydrodiol formation" ;
  skos:altLabel "trans-1,2-diol formation" ;
  skos:altLabel "epoxide hydration to trans-diol" ;
  skos:broader xmet:4000325 .

xmet:4000327 a skos:Concept ;
  skos:prefLabel "hydroxy/amino ring-end dehydrogenation" ;
  skos:definition "Ring carbon bound to OH or NH₂/NHR dehydrogenates to a quinoid C=O or C=NH/C=NR end under quinone-like endpoint transformations (Forest QuinoneFormation/single_to_double SMARTS [#6R:1][#8H,#7D1H2,#7D2H1:2]). Phenolic and anilinic children specialize the heteroatom. Not the shared single_to_double edit used internally by methide, iminium, or dealkylate patterns; not methide-end." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "Forest QuinoneFormation/single_to_double" ;
  skos:altLabel "phenol or aniline to quinoid" ;
  skos:altLabel "quinone C–heteroatom dehydrogenation" ;
  skos:altLabel "hydroxy/amino quinoid endpoint dehydrogenation" ;
  skos:broader xmet:4000364 .

xmet:4000328 a skos:Concept ;
  skos:prefLabel "aromatic CH to quinoid carbonyl" ;
  skos:definition "Install a quinoid carbonyl end at an aromatic CH (Forest QuinoneFormation/add_carbonyl_o) under quinone-like endpoint transformations. One-hop end state of hydroxylation followed by dehydrogenation (Forest canonical plan; has_part those elementary classes); also used in multi-end paths (e.g. benzene→benzoquinone via two ends)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "Forest QuinoneFormation/add_carbonyl_o" ;
  skos:altLabel "quinoid carbonyl-oxygen addition" ;
  skos:altLabel "aromatic CH oxygenation to quinoid carbonyl" ;
  skos:broader xmet:4000364 .

xmet:4000329 a skos:Concept ;
  skos:prefLabel "oxidative dehalogenation to quinoid carbonyl" ;
  skos:definition "Aryl halide → quinoid carbonyl end with dearomatization (Forest QuinoneFormation/replace_halogen) under quinone-like endpoint transformations. One-hop end state of oxidative dehalogenation followed by dehydrogenation when oxygen must be installed (Forest canonical plan; has_part those elementary classes). Not identical to the elementary oxidative dehalogenation rule alone." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "Forest QuinoneFormation/replace_halogen" ;
  skos:altLabel "quinoid oxidative dehalogenation endpoint" ;
  skos:altLabel "aryl halide to quinoid carbonyl" ;
  skos:broader xmet:4000364 .

xmet:4000330 a skos:Concept ;
  skos:prefLabel "dealkylative quinoid endpoint" ;
  skos:definition "Cleave an N/O-alkyl on a ring heteroatom while forming a quinoid end (Forest QuinoneFormation/dealkylate) under quinone-like endpoint transformations. Related to dealkylation but scoped as a quinoid-forming endpoint, not the general dealkylation rule." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "Forest QuinoneFormation/dealkylate" ;
  skos:altLabel "dealkylative quinone-like formation" ;
  skos:altLabel "quinone formation with dealkylation" ;
  skos:broader xmet:4000364 .

xmet:4000331 a skos:Concept ;
  skos:prefLabel "epoxide methyl-sulfone sulfation" ;
  skos:definition "Forest Sulfation/epoxide_methyl_sulfone: sulfation path yielding a methyl-sulfone motif from an epoxide partner." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000158 .

xmet:4000332 a skos:Concept ;
  skos:prefLabel "thiol glutathionation" ;
  skos:definition "Forest Glutathionation/thiol: GSH conjugation at a thiol electrophile / disulfide-exchange partner." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "GSH thiol conjugation" ;
  skos:broader xmet:4000374 .

xmet:4000333 a skos:Concept ;
  skos:prefLabel "alkene glutathionation" ;
  skos:definition "Forest Glutathionation/alkene: GSH addition across an alkene (non-Michael or general olefin path)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "GSH alkene addition" ;
  skos:broader xmet:4000372 .

xmet:4000334 a skos:Concept ;
  skos:prefLabel "carbonyl glutathionation" ;
  skos:definition "Forest Glutathionation/carbonyl: GSH addition to a carbonyl electrophile." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "GSH carbonyl addition" ;
  skos:broader xmet:4000372 .

xmet:4000335 a skos:Concept ;
  skos:prefLabel "mesylate glutathionation" ;
  skos:definition "Forest Glutathionation/mesylate: GSH displacement of a mesylate (or related sulfonate) leaving group." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "GSH mesylate displacement" ;
  skos:broader xmet:4000373 .

xmet:4000336 a skos:Concept ;
  skos:prefLabel "N-quaternary dealkylation" ;
  skos:definition "N-dealkylation at a quaternary carbon attached to nitrogen. Cleaved-carbon oxidation state is carried by Forest pattern alwaysWith (alcohol-level), not by hierarchy." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "N-quaternary dealkylation to alcohol" ;
  skos:broader xmet:4000348 .

xmet:4000337 a skos:Concept ;
  skos:prefLabel "N-hemiaminal collapse dealkylation" ;
  skos:definition "Forest NDealkylation/hemiaminal: hemiaminal collapse after N-oxidation / carbinolamine path." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000348 .

xmet:4000338 a skos:Concept ;
  skos:prefLabel "carbon oxidation" ;
  skos:definition "Carbon-centred oxygenation (C/c → C/c–O), Phase I carbon oxidation specialization." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000009 .

xmet:4000339 a skos:Concept ;
  skos:prefLabel "dioxygenation" ;
  skos:definition "Net addition of two oxygen atoms (ΔO=+2), typically arene dihydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "arene dioxygenation" ;
  skos:broader xmet:4000009 .

xmet:4000340 a skos:Concept ;
  skos:prefLabel "tertiary N-dealkylation" ;
  skos:definition "N-dealkylation of tertiary amine nitrogen (D3/H0 → D2/H≥1)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000347 .

xmet:4000341 a skos:Concept ;
  skos:prefLabel "secondary N-dealkylation" ;
  skos:definition "N-dealkylation of secondary amine nitrogen to primary (H1 → H2)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000347 .

xmet:4000342 a skos:Concept ;
  skos:prefLabel "antonym of" ;
  skos:definition "Opposite / inverse transformation sense (e.g. hydroxylation vs dehydroxylation). Symmetric." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "antonymOf" ;
  skos:altLabel "xmet:antonymOf" ;
  skos:altLabel "antonym" ;
  skos:broader xmet:4000281 .

xmet:4000343 a skos:Concept ;
  skos:prefLabel "dealkylation of alkyl carbons" ;
  skos:definition "Dealkylation distinguished by which alkyl carbon is lost (methyl, methylene, methine, quaternary, or C–C) and the oxidation state of the released fragment." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "alkyl-carbon dealkylation" ;
  skos:broader xmet:4000042 .

xmet:4000344 a skos:Concept ;
  skos:prefLabel "demethylation" ;
  skos:definition "Oxidative demethylation at N/O/S (heteroatom-general). Forest methyl_* patterns share this home; cleaved-carbon ox-state and released fragment via mapping alwaysWith. O-/S-demethylation specialize by heteroatom underneath." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000343 .

xmet:4000345 a skos:Concept ;
  skos:prefLabel "methylene dealkylation" ;
  skos:definition "Dealkylation at a methylene attached to N/O/S. Forest methylene_* patterns share this home; ox-state/fragment via alwaysWith. O-deethylation specializes underneath." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000343 .

xmet:4000346 a skos:Concept ;
  skos:prefLabel "methine dealkylation" ;
  skos:definition "Dealkylation at a methine attached to N/O/S. Forest methine_* patterns share this home; ox-state via alwaysWith." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000343 .

xmet:4000347 a skos:Concept ;
  skos:prefLabel "N-dealkylation of secondary and tertiary amines" ;
  skos:definition "N-dealkylation distinguished by amine substitution (secondary vs tertiary)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000043 .

xmet:4000348 a skos:Concept ;
  skos:prefLabel "N-dealkylation of alkyl carbons" ;
  skos:definition "N-dealkylation distinguished by which alkyl carbon is lost and the oxidation state of the released fragment." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000043 .

xmet:4000349 a skos:Concept ;
  skos:prefLabel "N-demethylation" ;
  skos:definition "Oxidative N–methyl cleavage (N-demethylation). Forest methyl_* patterns share this home; cleaved-carbon oxidation state and released fragment are distinguished via mapping alwaysWith." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "N-methyl dealkylation" ;
  skos:altLabel "N-demethylation by fragment oxidation" ;
  skos:broader xmet:4000348 .

xmet:4000350 a skos:Concept ;
  skos:prefLabel "N-methylene dealkylation" ;
  skos:definition "N-dealkylation at a methylene carbon attached to nitrogen (includes N-deethylation / N-depropylation site specializations). Forest methylene_* patterns share this home; ox-state / fragment via mapping alwaysWith." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000348 .

xmet:4000351 a skos:Concept ;
  skos:prefLabel "N-methine dealkylation" ;
  skos:definition "N-dealkylation at a methine carbon attached to nitrogen. Forest methine_* patterns share this home; ox-state via mapping alwaysWith." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000348 .

xmet:4000352 a skos:Concept ;
  skos:prefLabel "carboxylate ester hydrolysis" ;
  skos:definition "Hydrolytic cleavage of carboxylate esters and lactones." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "ester hydrolysis family" ;
  skos:broader xmet:4000293 .

xmet:4000353 a skos:Concept ;
  skos:prefLabel "carboxamide hydrolysis" ;
  skos:definition "Hydrolytic cleavage of amides, lactams, ureas, and carbamates." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "amide hydrolysis family" ;
  skos:broader xmet:4000293 .

xmet:4000354 a skos:Concept ;
  skos:prefLabel "ether bond hydrolysis" ;
  skos:definition "Hydrolytic ether cleavage / ether hydrolysis." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000293 .

xmet:4000355 a skos:Concept ;
  skos:prefLabel "nitrile bond hydrolysis" ;
  skos:definition "Hydrolysis of nitriles / cyanide-bearing carbonitriles." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000293 .

xmet:4000356 a skos:Concept ;
  skos:prefLabel "hydrolytic deacylation" ;
  skos:definition "Hydrolytic removal of acyl groups (acetyl, formyl, and general acyl)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000293 .

xmet:4000357 a skos:Concept ;
  skos:prefLabel "isoredox additions" ;
  skos:definition "Redox-neutral additions or insertions (alkylation, halogenation, amination, arylation, carbonylation, carboxylation, sulfuration, esterification)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000265 .

xmet:4000358 a skos:Concept ;
  skos:prefLabel "isoredox removals" ;
  skos:definition "Redox-neutral removals or extrusions (dehalogenation, decarboxylation, decarbonylation, dehydroxylation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000265 .

xmet:4000359 a skos:Concept ;
  skos:prefLabel "oxygen leaving fragment" ;
  skos:definition "Leaving groups that depart as oxygen-containing fragments (alcohol, phenol, carboxylate, sulfate, phosphate, water)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000261 .

xmet:4000360 a skos:Concept ;
  skos:prefLabel "nitrogen leaving fragment" ;
  skos:definition "Leaving groups that depart as nitrogen-containing fragments (amine, isocyanate, N₂)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000261 .

xmet:4000361 a skos:Concept ;
  skos:prefLabel "sulfur leaving fragment" ;
  skos:definition "Leaving groups that depart as sulfur-containing fragments (thiol)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000261 .

xmet:4000362 a skos:Concept ;
  skos:prefLabel "small inorganic leaving group" ;
  skos:definition "Small inorganic leaving groups (hydrogen, cyanide)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000261 .

xmet:4000364 a skos:Concept ;
  skos:prefLabel "quinone-like endpoint transformations" ;
  skos:definition "Pair-endpoint transformations under conjugated-system remodeling that install or complete a quinone-like (quinoid) end (Forest QuinoneFormation patterns). Named by transformation chemistry, not edit ids; some endpoints are one-hop end states of hydroxylation or oxidative dehalogenation followed by dehydrogenation (see has_part on those leaves)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "dehydrogenation endpoint transformations" ;
  skos:altLabel "quinoid endpoint transformations" ;
  skos:altLabel "QuinoneFormation endpoint patterns" ;
  skos:broader xmet:4000406 .

xmet:4000365 a skos:Concept ;
  skos:prefLabel "glutathione and thiol adduct formation" ;
  skos:definition "Adduct formation via GSH, cysteine, N-acetylcysteine, or mercapturic-acid pathways." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000267 .

xmet:4000366 a skos:Concept ;
  skos:prefLabel "cyanide adduct formation" ;
  skos:definition "Adduct formation by cyanide trapping / cyanidation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000267 .

xmet:4000367 a skos:Concept ;
  skos:prefLabel "macromolecular adducts" ;
  skos:definition "Covalent adducts to macromolecules (protein, DNA)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000267 .

xmet:4000368 a skos:Concept ;
  skos:prefLabel "adduct-forming additions" ;
  skos:definition "Addition mechanisms that form adducts (conjugate addition, nucleophilic aromatic substitution)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000267 .

xmet:4000369 a skos:Concept ;
  skos:prefLabel "acyl conjugations" ;
  skos:definition "Transfer of acyl or CoA groups (acetylation, formylation, transacylation, CoA conjugation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "acyl transfer conjugation" ;
  skos:broader xmet:4000266 .

xmet:4000370 a skos:Concept ;
  skos:prefLabel "heteroatom conjugations" ;
  skos:definition "Transfer conjugations with heteroatom or glycosyl donors (glucuronidation, glycosylation, sulfation, methylation, amino-acid conjugation, phosphorylation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "heteroatom transfer conjugation" ;
  skos:broader xmet:4000266 .

xmet:4000371 a skos:Concept ;
  skos:prefLabel "glutathionation of epoxides and aziridines" ;
  skos:definition "GSH attack on epoxides or aziridines." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000167 .

xmet:4000372 a skos:Concept ;
  skos:prefLabel "Michael and alkene glutathionation" ;
  skos:definition "GSH conjugate addition to Michael acceptors, alkenes, or carbonyl electrophiles." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000167 .

xmet:4000373 a skos:Concept ;
  skos:prefLabel "glutathionation with leaving-group displacement" ;
  skos:definition "GSH displacement of halide, mesylate, or isocyanate leaving groups." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000167 .

xmet:4000374 a skos:Concept ;
  skos:prefLabel "glutathionation of quinone-like species and thiols" ;
  skos:definition "Quinone-like (quinoid) species: two distinct sites on an aromatic system are oxidized/dehydrogenated so the ring collapses into a non-aromatic conjugated system. Covers classical quinones, quinone-imines, quinone-methides, and imine-methides. Forest “QuinoneFormation” uses this broad sense; the narrower classical quinone term sits underneath. GSH conjugation at quinoid electrophiles or at thiol partners." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "glutathionation of quinoids and thiols" ;
  skos:altLabel "glutathionation of quinones and thiols" ;
  skos:broader xmet:4000167 .

xmet:4000375 a skos:Concept ;
  skos:prefLabel "nitro-group reduction" ;
  skos:definition "Reduction along the nitro → nitroso → hydroxylamine → amine manifold, including N–O cleavages." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000093 .

xmet:4000376 a skos:Concept ;
  skos:prefLabel "azo reduction and cleavage" ;
  skos:definition "Reduction or cleavage of azo linkages." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000093 .

xmet:4000377 a skos:Concept ;
  skos:prefLabel "miscellaneous nitrogen reduction" ;
  skos:definition "Nitrogen reductions outside the nitro and azo manifolds (N-oxide, oxime, denitrosation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000093 .

xmet:4000378 a skos:Concept ;
  skos:prefLabel "hydroxylation at chain positions" ;
  skos:definition "Hydroxylation at defined chain positions (primary, secondary, ω, ω-1)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000012 .

xmet:4000379 a skos:Concept ;
  skos:prefLabel "hydroxylation of activated carbons" ;
  skos:definition "Hydroxylation at activated carbons (benzylic, allylic, α-to-heteroatom), regardless of primary/secondary/tertiary H-count." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000012 .

xmet:4000380 a skos:Concept ;
  skos:prefLabel "aliphatic and alicyclic hydroxylation" ;
  skos:definition "Hydroxylation of saturated aliphatic or alicyclic frameworks." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000012 .

xmet:4000381 a skos:Concept ;
  skos:prefLabel "epoxide CH glutathionation" ;
