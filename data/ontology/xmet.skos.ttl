  skos:definition "Glucuronidation of a carboxylate to an acyl glucuronide. Sibling of O-glucuronidation (hydroxy attachment); uses the carboxylate Forest pattern, not the alcohol pattern." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "acyl glucuronide formation" ;
  skos:broader xmet:4000148 .

xmet:4000153 a skos:Concept ;
