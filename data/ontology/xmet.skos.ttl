xmet:4000104 a skos:Concept ;
  skos:prefLabel "quinone-like reduction" ;
  skos:definition "Quinone-like (quinoid) species: two distinct sites on an aromatic system are oxidized/dehydrogenated so the ring collapses into a non-aromatic conjugated system. Covers classical quinones, quinone-imines, quinone-methides, and imine-methides. Forest “QuinoneFormation” uses this broad sense; the narrower classical quinone term sits underneath. Reduction of such a quinoid product back toward an aromatic (or less oxidized) form." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "quinoid reduction" ;
  skos:altLabel "quinone reduction" ;
  skos:broader xmet:4000105 .

xmet:4000105 a skos:Concept ;
