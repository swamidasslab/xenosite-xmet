  skos:broader xmet:4000356 .

xmet:4000192 a skos:Concept ;
  skos:prefLabel "denitrogenation" ;
  skos:definition "Metabolic loss of nitrogen from the scaffold (Rainbow excluded phase I remainder)." ;
