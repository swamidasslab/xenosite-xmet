xmet:4000390 a skos:Concept ;
  skos:prefLabel "dual nitro N–O cleavage" ;
  skos:definition "N–O cleavage covering charged and neutral nitro forms (leave 2 O)." ;
  skos:inScheme xmet:scheme ;
