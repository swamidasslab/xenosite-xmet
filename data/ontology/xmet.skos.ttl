  skos:broader xmet:4000358 .

xmet:4000194 a skos:Concept ;
  skos:prefLabel "dearomatization" ;
  skos:definition "Loss of aromatic character (arene oxide, quinone-like/quinoid products, thiophene S-oxide, cis-dihydrodiol, etc.)." ;
