@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xmet: <https://xenosite.org/ontology/xmet#> .
@prefix xmet: <https://xenosite.org/ontology/xmet#> .
@prefix dct: <http://purl.org/dc/terms/> .

xmet:scheme a skos:ConceptScheme ;
  skos:prefLabel "Xenobiotic Reaction Metabolism" ;
  skos:definition "Metabolism-specific med-chem SKOS thesaurus for xenobiotic reaction naming — not a full chemical ontology. Site-localized display names use templates outside the concept scheme. SSSOM maps to RXNO/MOP/GO/ChEBI/Rhea/KEGG/MeSH/ECO/CHMO." .

xmet:0000000 a skos:Concept ;
  skos:prefLabel "xenobiotic biotransformation" ;
  skos:definition "Chemical alteration of an exogenous substance in a biological system." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "xenobiotic metabolism" ;
  skos:altLabel "biotransformation" ;
  skos:altLabel "drug metabolism" .

xmet:0000001 a skos:Concept ;
  skos:prefLabel "phase I" ;
  skos:definition "Functionalization: oxidation, reduction, hydrolysis, and related edits that introduce or expose polar groups." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "phase 1" ;
  skos:altLabel "functionalization" ;
  skos:altLabel "Metabolic Detoxication, Phase I" ;
  skos:altLabel "phase 1 metabolism" ;
  skos:altLabel "functionalization phase" ;
  skos:broader xmet:1000000 ;
  skos:relatedMatch xmet:9000018 .

xmet:0000002 a skos:Concept ;
  skos:prefLabel "phase II" ;
  skos:definition "Conjugation with hydrophilic moieties (glucuronide, sulfate, glutathione, acetyl, methyl, amino acids, …)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "phase 2" ;
  skos:altLabel "conjugation" ;
  skos:altLabel "Metabolic Detoxication, Phase II" ;
  skos:altLabel "phase 2 metabolism" ;
  skos:altLabel "conjugation phase" ;
  skos:broader xmet:1000000 .

xmet:0000003 a skos:Concept ;
  skos:prefLabel "phase III transport" ;
  skos:definition "Transporter-mediated disposition related to xenobiotic handling; related to metabolism naming but not a primary reaction label." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "phase 3" ;
  skos:altLabel "phase III" ;
  skos:altLabel "transport phase" ;
  skos:broader xmet:1000000 .

xmet:0000010 a skos:Concept ;
  skos:prefLabel "stable oxygenation" ;
  skos:definition "Rainbow Phase I class: oxygenation that yields a stable oxygenated metabolite (aromatic/aliphatic hydroxylation, epoxidation, N-oxidation, S-oxidation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "SO class" ;
  skos:altLabel "stable oxygen addition class" ;
  skos:altLabel "Rainbow stable oxygenation" ;
  skos:altLabel "SO class (full name)" ;
  skos:altLabel "stable_oxygenation" ;
  skos:broader xmet:1200000 ;
  skos:relatedMatch xmet:9000010 .

xmet:0000011 a skos:Concept ;
  skos:prefLabel "unstable oxygenation" ;
  skos:definition "Rainbow Phase I class: oxygenation that triggers cleavage or rearrangement (N-/O-/S-/C-dealkylation, oxidative deamination, oxidative dehalogenation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "UO class" ;
  skos:altLabel "unstable oxygen addition class" ;
  skos:altLabel "Rainbow unstable oxygenation" ;
  skos:altLabel "UO class (full name)" ;
  skos:altLabel "unstable_oxygenation" ;
  skos:broader xmet:1200000 ;
  skos:relatedMatch xmet:9000011 .

xmet:0000012 a skos:Concept ;
  skos:prefLabel "dehydrogenation" ;
  skos:definition "Phase I class that extracts hydrogen(s) to form a multiple bond, iminium, or quinoid (alcohol→carbonyl, bond unsaturation, quinone/imine/methide formation, iminium formation). Maps to the Metabolic Forest / Rainbow dehydrogenation ruleset; prefer this full name over localized abbreviations." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "desaturation" ;
  skos:broader xmet:1100000 ;
  skos:broader xmet:0000001 ;
  skos:broader xmet:1200000 ;
  skos:relatedMatch xmet:9000012 ;
  skos:relatedMatch xmet:9100300 ;
  skos:relatedMatch xmet:7000001 ;
  skos:relatedMatch xmet:7200003 ;
  skos:relatedMatch xmet:7700004 ;
  skos:relatedMatch xmet:7400003 .

xmet:0000013 a skos:Concept ;
  skos:prefLabel "hydrolysis" ;
  skos:definition "Phase I class in which water addition cleaves amide, ester, ether, or related bonds (including cyanide/nitrile hydrolysis). Maps to the Metabolic Forest / Rainbow hydrolysis ruleset; prefer this full name over localized abbreviations." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1100000 ;
  skos:broader xmet:0000001 ;
  skos:broader xmet:1200000 ;
  skos:relatedMatch xmet:9000013 ;
  skos:relatedMatch xmet:9100400 ;
  skos:relatedMatch xmet:7000003 ;
  skos:relatedMatch xmet:7200002 ;
  skos:relatedMatch xmet:7300002 ;
  skos:relatedMatch xmet:7700005 .

xmet:0000014 a skos:Concept ;
  skos:prefLabel "reduction" ;
  skos:definition "Phase I class that removes oxygen or adds hydrogen(s) (nitro, carbonyl, and sulfo reduction; reductive dehalogenation; hydrogenation). Maps to the Metabolic Forest / Rainbow reduction ruleset; prefer this full name over localized abbreviations." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1100000 ;
  skos:broader xmet:0000001 ;
  skos:broader xmet:1200000 ;
  skos:relatedMatch xmet:9000014 ;
  skos:relatedMatch xmet:7000002 ;
  skos:relatedMatch xmet:7400003 .

xmet:0000020 a skos:Concept ;
  skos:prefLabel "oxidation" ;
  skos:definition "Phase I oxidations broadly (carbon and heteroatom)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxidative metabolism" ;
  skos:broader xmet:1100000 ;
  skos:broader xmet:0000001 ;
  skos:relatedMatch xmet:0000010 ;
  skos:relatedMatch xmet:0000011 .

xmet:0000021 a skos:Concept ;
  skos:prefLabel "carbon oxidation" ;
  skos:definition "Oxidation at carbon (hydroxylation, epoxidation, alcohol/aldehyde oxidation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:0000020 .

xmet:0000022 a skos:Concept ;
  skos:prefLabel "heteroatom oxidation" ;
  skos:definition "Direct oxidation of N, S (and related heteroatoms)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:0000020 .

xmet:0000023 a skos:Concept ;
  skos:prefLabel "carbon–heteroatom oxidative cleavage" ;
  skos:definition "α-Carbon hydroxylation followed by C–X cleavage (N-/O-/S-dealkylation, oxidative deamination)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "α-carbon hydroxylation cleavage" ;
  skos:broader xmet:0000020 .

xmet:0000024 a skos:Concept ;
  skos:prefLabel "conjugation" ;
  skos:definition "Attachment of a hydrophilic moiety (Metabolic Forest conjugation ruleset: acetylation, glucuronidation, glutathionation, sulfation, and related Phase II paths)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1100000 ;
  skos:closeMatch xmet:0000002 ;
  skos:relatedMatch xmet:0001000 ;
  skos:relatedMatch xmet:0001010 ;
  skos:relatedMatch xmet:0001020 ;
  skos:relatedMatch xmet:0001030 ;
  skos:relatedMatch xmet:9000016 .

xmet:0000100 a skos:Concept ;
  skos:prefLabel "hydroxylation" ;
  skos:definition "Introduction of a hydroxyl group, typically at carbon." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "C-hydroxylation" ;
  skos:altLabel "monooxygenation hydroxylation" ;
  skos:broader xmet:0000021 ;
  skos:broader xmet:0000010 ;
  skos:relatedMatch xmet:9100100 ;
  skos:relatedMatch xmet:7000001 ;
  skos:relatedMatch xmet:7100001 ;
  skos:relatedMatch xmet:7200001 ;
  skos:relatedMatch xmet:7300001 ;
  skos:relatedMatch xmet:7400001 ;
  skos:relatedMatch xmet:7700001 ;
  skos:relatedMatch xmet:2400012 ;
  skos:relatedMatch xmet:0000650 .

xmet:0000101 a skos:Concept ;
  skos:prefLabel "aromatic hydroxylation" ;
  skos:definition "Hydroxylation of an aromatic ring; often via arene oxide / NIH-shift pathways." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "aryl hydroxylation" ;
  skos:altLabel "benzene hydroxylation" ;
  skos:altLabel "arene hydroxylation" ;
  skos:broader xmet:0000100 ;
  skos:relatedMatch xmet:8000003 ;
  skos:relatedMatch xmet:7800001 ;
  skos:relatedMatch xmet:1500118 ;
  skos:relatedMatch xmet:0000303 ;
  skos:relatedMatch xmet:0000300 .

