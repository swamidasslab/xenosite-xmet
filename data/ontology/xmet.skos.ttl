  skos:inScheme xmet:scheme ;
  skos:broader xmet:7700000 ;
  skos:relatedMatch xmet:0000210 .

xmet:7700010 a skos:Concept ;
  skos:prefLabel "no heavy-atom delta" ;
  skos:definition "Heavy-atom formula unchanged (tautomer, many dehydrogenations if H ignored, rearrangements)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7700000 ;
  skos:relatedMatch xmet:0002000 .

xmet:7700011 a skos:Concept ;
  skos:prefLabel "formula-delta unspecified" ;
  skos:definition "Formula delta class not asserted." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7700000 .

xmet:7800000 a skos:Concept ;
  skos:prefLabel "site aromaticity" ;
  skos:definition "Cross-cutting spine: aromatic character of the mapped site on the reactant." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "site_aromaticity" ;
  skos:broader xmet:1600000 .

xmet:7800001 a skos:Concept ;
  skos:prefLabel "aromatic site" ;
  skos:definition "Mapped site atom(s) are aromatic on the reactant." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7800000 ;
  skos:relatedMatch xmet:0000101 .

xmet:7800002 a skos:Concept ;
  skos:prefLabel "aliphatic site" ;
  skos:definition "Mapped site atom(s) are non-aromatic on the reactant." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7800000 ;
  skos:relatedMatch xmet:0000102 .

xmet:7800003 a skos:Concept ;
  skos:prefLabel "site aromaticity unspecified" ;
  skos:definition "Aromaticity of the site was not determined (no map / no probe)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7800000 .

xmet:7900000 a skos:Concept ;
  skos:prefLabel "pathway-step role" ;
  skos:definition "Cross-cutting spine: role of this step in a multi-step metabolic path." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:1700000 .

xmet:7900001 a skos:Concept ;
  skos:prefLabel "direct one-step transformation" ;
  skos:definition "Observed product arises in a single metabolic step from the named parent." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7900000 ;
  skos:relatedMatch xmet:0000307 .

xmet:7900002 a skos:Concept ;
  skos:prefLabel "multi-step pathway member" ;
  skos:definition "Step participates in a path of depth ≥ 2 (e.g. two- or three-step quinone formation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7900000 ;
  skos:relatedMatch xmet:0000300 ;
  skos:relatedMatch xmet:0000308 ;
  skos:relatedMatch xmet:0000309 .

xmet:7900003 a skos:Concept ;
  skos:prefLabel "preparatory intermediate step" ;
  skos:definition "Intermediate that enables a subsequent defining step (e.g. hydroxylation before quinone formation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7900000 ;
  skos:relatedMatch xmet:0000308 ;
  skos:relatedMatch xmet:0000309 .

xmet:7900004 a skos:Concept ;
  skos:prefLabel "terminal observable step" ;
  skos:definition "Last enumerated step yielding the reported metabolite." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7900000 .

xmet:7900005 a skos:Concept ;
  skos:prefLabel "pathway-step role unspecified" ;
  skos:definition "Step role in a path is not asserted." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:7900000 .

xmet:8000000 a skos:Concept ;
  skos:prefLabel "aromatic and conjugated-system impact" ;
  skos:definition "Parallel hierarchy focused on how a transformation impacts aromatic and conjugated π-systems: loss or gain of aromaticity, engagement of conjugated acceptors, and rearrangements within those systems. Orthogonal to both the chemist reaction-type spine and the Metabolic Forest map." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "aromatic/conjugate impact" ;
  skos:altLabel "π-system impact" ;
  skos:broader xmet:1700000 .

xmet:8000001 a skos:Concept ;
  skos:prefLabel "aromaticity loss" ;
  skos:definition "Transformations that destroy or interrupt an aromatic system." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:8000000 ;
  skos:relatedMatch xmet:0004001 .

xmet:8000002 a skos:Concept ;
  skos:prefLabel "aromaticity gain" ;
  skos:definition "Transformations that form or restore an aromatic system." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:8000000 ;
  skos:relatedMatch xmet:0004002 ;
  skos:relatedMatch xmet:0000315 .

xmet:8000003 a skos:Concept ;
  skos:prefLabel "aromatic ring substitution impact" ;
  skos:definition "Substitution on an aromatic ring that preserves the aromatic sextet (e.g. phenolic hydroxylation after NIH shift)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:8000000 ;
  skos:relatedMatch xmet:0000101 ;
  skos:relatedMatch xmet:0004003 ;
  skos:relatedMatch xmet:0004004 .

xmet:8000004 a skos:Concept ;
  skos:prefLabel "conjugated π-system engagement" ;
  skos:definition "Reactions whose defining impact is engagement of a conjugated acceptor or donor (Michael acceptors, quinoids, extended enones)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:8000000 ;
  skos:relatedMatch xmet:0004014 ;
  skos:relatedMatch xmet:0000300 ;
  skos:relatedMatch xmet:0001031 .

xmet:8000005 a skos:Concept ;
  skos:prefLabel "quinoid π-system formation" ;
  skos:definition "Formation of quinone, quinone-imine, quinone-methide, or imine-methide π-systems from aromatic or conjugated precursors." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:8000000 ;
  skos:relatedMatch xmet:0000300 ;
  skos:relatedMatch xmet:0000303 ;
  skos:relatedMatch xmet:0000304 ;
  skos:relatedMatch xmet:0000306 .

xmet:8000006 a skos:Concept ;
  skos:prefLabel "heteroaromatic oxidation impact" ;
  skos:definition "Oxidation paths that specifically perturb heteroaromatic rings (e.g. thiophene S-oxidation or epoxidation)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:8000000 ;
  skos:relatedMatch xmet:0000133 ;
  skos:relatedMatch xmet:0000113 .

xmet:8000007 a skos:Concept ;
  skos:prefLabel "arene oxide pathway" ;
  skos:definition "Passage through an arene oxide / NIH-shift manifold on an aromatic ring." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:8000000 ;
  skos:relatedMatch xmet:0000112 ;
  skos:relatedMatch xmet:0004003 ;
  skos:relatedMatch xmet:0004005 .

xmet:8000008 a skos:Concept ;
  skos:prefLabel "conjugated adduct formation" ;
  skos:definition "Conjugation (e.g. GSH) that captures a conjugated electrophile without requiring the reaction type hierarchy." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:8000000 ;
  skos:relatedMatch xmet:0001031 ;
  skos:relatedMatch xmet:0001036 ;
  skos:relatedMatch xmet:0004014 .

