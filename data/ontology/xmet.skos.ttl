@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xmet: <https://xenosite.org/ontology/xmet#> .
@prefix xmet: <https://xenosite.org/ontology/xmet#> .
@prefix dct: <http://purl.org/dc/terms/> .

xmet:scheme a skos:ConceptScheme ;
  skos:prefLabel "Xenobiotic Reaction Metabolism" ;
  skos:definition "Metabolism-specific med-chem SKOS thesaurus for xenobiotic reaction naming — not a full chemical ontology. Site-localized display names use templates outside the concept scheme. SSSOM maps to RXNO/MOP/GO/ChEBI/Rhea/KEGG/MeSH/ECO/CHMO." .

xmet:4000000 a skos:Concept ;
  skos:prefLabel "xenobiotic biotransformation" ;
  skos:definition "Chemical alteration of an exogenous substance in a biological system." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "xenobiotic metabolism" ;
  skos:altLabel "biotransformation" ;
  skos:altLabel "drug metabolism" .

xmet:4000001 a skos:Concept ;
  skos:prefLabel "phase I" ;
  skos:definition "Functionalization stage tag: oxidation, reduction, hydrolysis, and related edits that introduce or expose polar groups. Not a chemical superclass." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "phase 1" ;
  skos:altLabel "functionalization" ;
  skos:altLabel "Metabolic Detoxication, Phase I" ;
  skos:altLabel "phase 1 metabolism" ;
  skos:altLabel "functionalization phase" ;
  skos:broader xmet:4000212 .

xmet:4000002 a skos:Concept ;
  skos:prefLabel "phase II" ;
  skos:definition "Conjugation stage tag: binding to endogenous moieties. Not a chemical superclass — transfer conjugations and adducts are distinguished under reaction class." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "phase 2" ;
  skos:altLabel "conjugation" ;
  skos:altLabel "Metabolic Detoxication, Phase II" ;
  skos:altLabel "phase 2 metabolism" ;
  skos:altLabel "conjugation phase" ;
  skos:broader xmet:4000212 .

xmet:4000003 a skos:Concept ;
  skos:prefLabel "phase III" ;
  skos:definition "Further handling / transport / excretion-related disposition of conjugates and metabolites. Disposition tag, not a reaction class." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "phase 3" ;
  skos:altLabel "phase III" ;
  skos:altLabel "transport phase" ;
  skos:broader xmet:4000212 .

xmet:4000004 a skos:Concept ;
  skos:prefLabel "stable oxygenation" ;
  skos:definition "Rainbow Phase I class: oxygenation that yields a stable oxygenated metabolite (aromatic/aliphatic hydroxylation, epoxidation, N-oxidation, S-oxidation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "SO class" ;
  skos:altLabel "stable oxygen addition class" ;
  skos:altLabel "Rainbow stable oxygenation" ;
  skos:altLabel "SO class (full name)" ;
  skos:altLabel "stable_oxygenation" ;
  skos:broader xmet:4000009 .

xmet:4000005 a skos:Concept ;
  skos:prefLabel "unstable oxygenation" ;
  skos:definition "Rainbow Phase I class: oxygenation that triggers cleavage or rearrangement (N-/O-/S-/C-dealkylation, oxidative deamination, oxidative dehalogenation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "UO class" ;
  skos:altLabel "unstable oxygen addition class" ;
  skos:altLabel "Rainbow unstable oxygenation" ;
  skos:altLabel "UO class (full name)" ;
  skos:altLabel "unstable_oxygenation" ;
  skos:broader xmet:4000009 .

xmet:4000006 a skos:Concept ;
  skos:prefLabel "dehydrogenation" ;
  skos:definition "Rainbow dehydrogenation color: extract hydrogen(s) to form a multiple bond, iminium, or quinoid. Nested under oxidation. Often an elementary part of conjugated-system remodeling (including quinone-like paths)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "desaturation" ;
  skos:broader xmet:4000009 .

xmet:4000007 a skos:Concept ;
  skos:prefLabel "hydrolysis" ;
  skos:definition "Rainbow hydrolysis color: water addition cleaves amide, ester, ether, or related bonds. Nested under isoredox (redox-neutral)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000265 .

xmet:4000008 a skos:Concept ;
  skos:prefLabel "reduction" ;
  skos:definition "Reduction class (Rainbow reduction color): remove oxygen or add hydrogen(s) (nitro, carbonyl, sulfo reduction; reductive dehalogenation; hydrogenation). Peer of oxidation and isoredox under reaction class." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000213 .

xmet:4000009 a skos:Concept ;
  skos:prefLabel "oxidation" ;
  skos:definition "Oxidations and related increase of oxidation state. Holds Rainbow stable oxygenation, unstable oxygenation, and dehydrogenation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxidative metabolism" ;
  skos:broader xmet:4000213 .

xmet:4000010 a skos:Concept ;
  skos:prefLabel "heteroatom oxidation" ;
  skos:definition "Direct oxidation of N, S (and related heteroatoms)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000004 .

xmet:4000011 a skos:Concept ;
  skos:prefLabel "conjugation" ;
  skos:definition "Addition of an endogenous or trapping moiety. Split into transfer conjugation (clearance-oriented) and adduct formation (electrophile capture)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000213 ;
  skos:closeMatch xmet:4000002 .

xmet:4000012 a skos:Concept ;
  skos:prefLabel "hydroxylation" ;
  skos:definition "Introduction of a hydroxyl group, typically at carbon." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "C-hydroxylation" ;
  skos:altLabel "monooxygenation hydroxylation" ;
  skos:altLabel "hydroxylation to alcohol" ;
  skos:altLabel "hydroxylation to alcohol or oxide" ;
  skos:broader xmet:4000004 .

xmet:4000013 a skos:Concept ;
  skos:prefLabel "aromatic hydroxylation" ;
  skos:definition "Hydroxylation of an aromatic ring; often via arene oxide / NIH-shift pathways. Often an elementary part of conjugated-system remodeling toward quinone-like species." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "aryl hydroxylation" ;
  skos:altLabel "benzene hydroxylation" ;
  skos:altLabel "arene hydroxylation" ;
  skos:altLabel "aromatic hydroxylation to phenol" ;
  skos:altLabel "aromatic hydroxylation to phenol or phenolate" ;
  skos:broader xmet:4000012 .

xmet:4000014 a skos:Concept ;
  skos:prefLabel "aliphatic hydroxylation" ;
  skos:definition "Hydroxylation of an aliphatic carbon (not limited to methyl/methylene; see also tertiary carbon hydroxylation under methine hydroxylation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "alkyl hydroxylation" ;
  skos:broader xmet:4000380 .

xmet:4000015 a skos:Concept ;
  skos:prefLabel "para-hydroxylation" ;
  skos:definition "Para-regioselective aromatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000013 .

xmet:4000016 a skos:Concept ;
  skos:prefLabel "ortho-hydroxylation" ;
  skos:definition "Ortho-regioselective aromatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000013 .

xmet:4000017 a skos:Concept ;
  skos:prefLabel "meta-hydroxylation" ;
  skos:definition "Meta-regioselective aromatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000013 .

xmet:4000018 a skos:Concept ;
  skos:prefLabel "benzylic hydroxylation" ;
  skos:definition "Hydroxylation at a carbon adjacent to an aromatic ring (benzylic). May be methyl, methylene, or methine; under hydroxylation of activated carbons." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "toluene side-chain hydroxylation" ;
  skos:broader xmet:4000379 .

xmet:4000019 a skos:Concept ;
  skos:prefLabel "allylic hydroxylation" ;
  skos:definition "Hydroxylation at a carbon adjacent to a C=C bond (allylic). Under hydroxylation of activated carbons; not restricted to methine sites." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000379 .

xmet:4000020 a skos:Concept ;
  skos:prefLabel "ω-hydroxylation" ;
  skos:definition "ω-hydroxylation: xenobiotic-metabolism term under aliphatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "omega-hydroxylation" ;
  skos:altLabel "terminal methyl hydroxylation" ;
  skos:broader xmet:4000378 .

xmet:4000021 a skos:Concept ;
  skos:prefLabel "ω-1 hydroxylation" ;
  skos:definition "ω-1 hydroxylation: xenobiotic-metabolism term under aliphatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "omega-1 hydroxylation" ;
  skos:altLabel "penultimate carbon hydroxylation" ;
  skos:broader xmet:4000378 .

xmet:4000022 a skos:Concept ;
  skos:prefLabel "epoxidation" ;
  skos:definition "Formation of a three-membered epoxide ring." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxirane formation" ;
  skos:broader xmet:4000004 .

xmet:4000023 a skos:Concept ;
  skos:prefLabel "alkene epoxidation" ;
  skos:definition "alkene epoxidation: xenobiotic-metabolism term under epoxidation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000022 .

xmet:4000024 a skos:Concept ;
  skos:prefLabel "arene oxide formation" ;
  skos:definition "Epoxidation of an aromatic π-system to an arene oxide intermediate." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "arene oxide" ;
  skos:broader xmet:4000290 .

xmet:4000025 a skos:Concept ;
  skos:prefLabel "thiophene epoxidation" ;
  skos:definition "thiophene epoxidation: xenobiotic-metabolism term under epoxidation, heteroaromatic oxidation impact." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "thiohene epoxidation" ;
  skos:broader xmet:4000022 .

xmet:4000026 a skos:Concept ;
  skos:prefLabel "nitrogen oxidation" ;
  skos:definition "nitrogen oxidation: xenobiotic-metabolism term under heteroatom oxidation, stable oxygenation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "N-oxidation" ;
  skos:broader xmet:4000010 .

xmet:4000027 a skos:Concept ;
  skos:prefLabel "N-oxide formation" ;
  skos:definition "Formation of an N-oxide from a tertiary amine (or equivalent trivalent nitrogen with no N–H)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "tertiary amine N-oxidation" ;
  skos:broader xmet:4000026 .

xmet:4000028 a skos:Concept ;
  skos:prefLabel "hydroxylamine formation" ;
  skos:definition "Formation of a hydroxylamine by N-oxidation of a primary or secondary amine (N–H → N–OH)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "N-hydroxylation" ;
  skos:broader xmet:4000026 .

xmet:4000029 a skos:Concept ;
  skos:prefLabel "nitroso formation" ;
  skos:definition "Formation of a nitroso group by N-oxidation of a primary amine (–NH2 → –N=O)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000026 .

xmet:4000030 a skos:Concept ;
  skos:prefLabel "primary amine N-oxidation" ;
  skos:definition "N-oxidation of a primary amine, typically yielding a hydroxylamine (or further nitroso)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000028 .

xmet:4000031 a skos:Concept ;
  skos:prefLabel "aromatic amine N-oxidation" ;
  skos:definition "N-oxidation of an aromatic amine, typically yielding an aryl hydroxylamine." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000028 .

xmet:4000032 a skos:Concept ;
  skos:prefLabel "sulfur oxidation" ;
  skos:definition "sulfur oxidation: xenobiotic-metabolism term under heteroatom oxidation, stable oxygenation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "S-oxidation" ;
  skos:broader xmet:4000010 .

xmet:4000033 a skos:Concept ;
  skos:prefLabel "sulfoxidation" ;
  skos:definition "sulfoxidation: xenobiotic-metabolism term under sulfur oxidation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "sulfoxide formation" ;
  skos:broader xmet:4000299 .

xmet:4000034 a skos:Concept ;
  skos:prefLabel "sulfone formation" ;
  skos:definition "sulfone formation: xenobiotic-metabolism term under sulfur oxidation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000299 .

xmet:4000035 a skos:Concept ;
  skos:prefLabel "thiophene S-oxidation" ;
  skos:definition "S-oxidation of a thiophene ring; a dearomatizing path to S-oxides." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "Thiohene S-oxidation" ;
  skos:altLabel "thiohene S-oxidation" ;
  skos:broader xmet:4000032 .

xmet:4000036 a skos:Concept ;
  skos:prefLabel "thiol oxidation" ;
  skos:definition "thiol oxidation: xenobiotic-metabolism term under sulfur oxidation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000298 .

xmet:4000037 a skos:Concept ;
  skos:prefLabel "disulfide formation" ;
  skos:definition "Formation of a disulfide (R–S–S–R′) by sulfur oxidation / oxidative coupling. Does not require an S=O (sulfur oxo) bond." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000032 .

xmet:4000038 a skos:Concept ;
  skos:prefLabel "primary carbon hydroxylation" ;
  skos:definition "primary carbon hydroxylation: xenobiotic-metabolism term under aliphatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000378 .

xmet:4000039 a skos:Concept ;
  skos:prefLabel "secondary carbon hydroxylation" ;
  skos:definition "secondary carbon hydroxylation: xenobiotic-metabolism term under aliphatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000378 .

xmet:4000040 a skos:Concept ;
  skos:prefLabel "tertiary carbon hydroxylation" ;
  skos:definition "tertiary carbon hydroxylation: xenobiotic-metabolism term under aliphatic hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000291 .

xmet:4000041 a skos:Concept ;
  skos:prefLabel "alicyclic hydroxylation" ;
  skos:definition "Hydroxylation of a saturated ring carbon." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000380 .

xmet:4000042 a skos:Concept ;
  skos:prefLabel "dealkylation" ;
  skos:definition "Oxidative removal of an alkyl group from N, O, S, or C via α-carbon hydroxylation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxidative dealkylation" ;
  skos:altLabel "carbon–heteroatom oxidative cleavage" ;
  skos:broader xmet:4000005 .

xmet:4000043 a skos:Concept ;
  skos:prefLabel "N-dealkylation" ;
  skos:definition "N-dealkylation: xenobiotic-metabolism term under dealkylation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxidative N-dealkylation" ;
  skos:altLabel "N-dealkylative cleavage" ;
  skos:broader xmet:4000042 .

xmet:4000044 a skos:Concept ;
  skos:prefLabel "O-dealkylation" ;
  skos:definition "O-dealkylation: xenobiotic-metabolism term under dealkylation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxidative O-dealkylation" ;
  skos:broader xmet:4000042 .

xmet:4000045 a skos:Concept ;
  skos:prefLabel "S-dealkylation" ;
  skos:definition "S-dealkylation: xenobiotic-metabolism term under dealkylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000042 .

xmet:4000046 a skos:Concept ;
  skos:prefLabel "C-dealkylation" ;
  skos:definition "Oxidative cleavage of a carbon–carbon bond with loss of an alkyl fragment (xenobiotic C-dealkylation). Chemically oxidative C–C cleavage, not N-/O-/S-dealkylation. Forest cc_alcohol / cc_carbonyl share this home; ox-state via alwaysWith. Quaternary site child for cc_quaternary_alcohol." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxidative C–C cleavage" ;
  skos:altLabel "oxidative carbon–carbon cleavage" ;
  skos:altLabel "carbon–carbon dealkylation" ;
  skos:broader xmet:4000042 .

xmet:4000047 a skos:Concept ;
  skos:prefLabel "N-deethylation" ;
  skos:definition "N-deethylation: xenobiotic-metabolism term under N-dealkylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000350 .

xmet:4000048 a skos:Concept ;
  skos:prefLabel "N-depropylation" ;
  skos:definition "N-depropylation: xenobiotic-metabolism term under N-dealkylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000350 .

xmet:4000049 a skos:Concept ;
  skos:prefLabel "oxidative deamination" ;
  skos:definition "α-Carbon hydroxylation of a primary (or suitable) amine releasing ammonia/amine and a carbonyl." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "deamination" ;
  skos:broader xmet:4000318 .

xmet:4000050 a skos:Concept ;
  skos:prefLabel "O-demethylation" ;
  skos:definition "O-demethylation: xenobiotic-metabolism term under O-dealkylation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "aryl methyl ether cleavage" ;
  skos:altLabel "oxidative O-demethylation" ;
  skos:broader xmet:4000344 .

xmet:4000051 a skos:Concept ;
  skos:prefLabel "oxidative dehalogenation" ;
  skos:definition "Replacement of halogen by oxygen via oxidative pathways. Under unstable oxygenation; related to isoredox dehalogenation (not a subtype of it)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxidative dehalogenation" ;
  skos:broader xmet:4000005 .

xmet:4000052 a skos:Concept ;
  skos:prefLabel "O-deethylation" ;
  skos:definition "O-deethylation: xenobiotic-metabolism term under O-dealkylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000345 .

xmet:4000053 a skos:Concept ;
  skos:prefLabel "aromatic O-dealkylation" ;
  skos:definition "Cleavage of an aryl–O–alkyl ether (e.g. anisole → phenol)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000044 .

xmet:4000054 a skos:Concept ;
  skos:prefLabel "aliphatic O-dealkylation" ;
  skos:definition "aliphatic O-dealkylation: xenobiotic-metabolism term under O-dealkylation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000044 .

xmet:4000055 a skos:Concept ;
  skos:prefLabel "oxidative defluorination" ;
  skos:definition "oxidative defluorination: xenobiotic-metabolism term under oxidative dehalogenation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000307 .

xmet:4000056 a skos:Concept ;
  skos:prefLabel "oxidative dechlorination" ;
  skos:definition "oxidative dechlorination: xenobiotic-metabolism term under oxidative dehalogenation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000307 .

xmet:4000057 a skos:Concept ;
  skos:prefLabel "oxidative debromination" ;
  skos:definition "oxidative debromination: xenobiotic-metabolism term under oxidative dehalogenation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000307 .

xmet:4000058 a skos:Concept ;
  skos:prefLabel "S-demethylation" ;
  skos:definition "Oxidative removal of an S-methyl group." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "oxidative S-demethylation" ;
  skos:broader xmet:4000344 .

xmet:4000059 a skos:Concept ;
  skos:prefLabel "quinone-like species formation" ;
  skos:definition "Aromatic→quinoid remodeling under conjugated-system remodeling: two distinct sites on an aromatic system are oxidized/dehydrogenated so the ring collapses into a non-aromatic conjugated quinoid (classical quinones, quinone-imines, quinone-methides, imine-methides). Not necessarily a composite pathway — an already hydroxylated precursor may need only terminating dehydrogenation. Specific multi-step routes may be modeled under composite transformation. Tagger struct-quinone-formation homes here; the broader Forest QuinoneFormation rule homes on conjugated-system remodeling." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "quinoid formation" ;
  skos:altLabel "quinoid species formation" ;
  skos:altLabel "quinone-like formation" ;
  skos:altLabel "quinonation" ;
  skos:broader xmet:4000406 .

xmet:4000060 a skos:Concept ;
  skos:prefLabel "ortho-quinone formation" ;
  skos:definition "Formation of an ortho-quinone (1,2-diketone): two adjacent ring sites are oxidized/dehydrogenated, collapsing aromaticity into a conjugated non-aromatic ortho-quinoid. Narrow classical quinone, not quinone-imine/methide." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "o-quinone formation" ;
  skos:altLabel "1,2-quinone formation" ;
  skos:altLabel "ortho-quinoid formation" ;
  skos:broader xmet:4000394 .

xmet:4000061 a skos:Concept ;
  skos:prefLabel "para-quinone formation" ;
  skos:definition "Formation of a para-quinone (1,4-diketone): two para-related ring sites are oxidized/dehydrogenated, collapsing aromaticity into a conjugated non-aromatic para-quinoid. Narrow classical quinone, not quinone-imine/methide." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "p-quinone formation" ;
  skos:altLabel "1,4-quinone formation" ;
  skos:altLabel "para-quinoid formation" ;
  skos:broader xmet:4000394 .

xmet:4000062 a skos:Concept ;
  skos:prefLabel "quinone-imine formation" ;
  skos:definition "Formation of a quinone-imine: one or both quinoid ends are C=N rather than C=O. Two distinct sites are dehydrogenated so an aromatic system collapses into a non-aromatic conjugated quinoid (e.g. NAPQI-type). Sibling of classical quinone formation under quinone-like species formation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "quinone imine formation" ;
  skos:altLabel "NAPQI-type formation" ;
  skos:altLabel "quinoid imine formation" ;
  skos:broader xmet:4000059 .

xmet:4000063 a skos:Concept ;
  skos:prefLabel "quinone-methide formation" ;
  skos:definition "Formation of a quinone-methide: a quinoid with an exocyclic alkylidene/methide end (including imine-methide variants). Two distinct sites are dehydrogenated so an aromatic system collapses into a non-aromatic conjugated quinoid. Sibling of classical quinone formation under quinone-like species formation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "quinone methide formation" ;
  skos:altLabel "quinoid methide formation" ;
  skos:altLabel "imine-methide formation" ;
  skos:broader xmet:4000059 .

xmet:4000064 a skos:Concept ;
  skos:prefLabel "iminium ion formation" ;
  skos:definition "Formation of an iminium ion, typically by amine dehydrogenation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "iminium formation" ;
  skos:broader xmet:4000216 .

xmet:4000065 a skos:Concept ;
  skos:prefLabel "imine-methide formation" ;
  skos:definition "Formation of an imine-methide (or related methide) from an amine dehydrogenation path." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "imine methide formation" ;
  skos:broader xmet:4000216 .

xmet:4000066 a skos:Concept ;
  skos:prefLabel "one-step" ;
  skos:definition "Descriptor: transformation counted as a single formal metabolic step. For quinone-like species formation, the elementary-plan dependency cone into terminating dehydrogenation has size 1 (DH alone — both quinoid ends already present). Free co-occurring plan steps that do not precede DH do not deepen this count." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "1-step" ;
  skos:altLabel "single-step" ;
  skos:altLabel "one-step transformation" ;
  skos:altLabel "one-step quinone-like species formation" ;
  skos:altLabel "1-step quinone-like species formation" ;
  skos:altLabel "direct quinone-like species formation" ;
  skos:altLabel "one-step quinone formation" ;
  skos:broader xmet:4000393 .

xmet:4000067 a skos:Concept ;
  skos:prefLabel "two-step" ;
  skos:definition "Descriptor: transformation counted as two formal metabolic steps. For quinone-like species formation, the dependency cone into terminating dehydrogenation has size 2 — one preparatory elementary step that precedes DH, then DH (prep typically hydroxylation or oxidative dehalogenation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "2-step" ;
  skos:altLabel "two-step transformation" ;
  skos:altLabel "two-step quinone-like species formation" ;
  skos:altLabel "2-step quinone-like species formation" ;
  skos:altLabel "two-step quinone formation" ;
  skos:broader xmet:4000393 .

