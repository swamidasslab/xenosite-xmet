xmet:4000392 a skos:Concept ;
  skos:prefLabel "alkene to vicinal diol pathway" ;
  skos:definition "Composite: epoxidation of an alkene/arene followed by hydrolytic epoxide opening to a vicinal diol (Forest EpoxideHydration one-hop)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "epoxide hydration composite" ;
  skos:altLabel "alkene dihydrodiol pathway" ;
  skos:broader xmet:4000272 .

xmet:4000393 a skos:Concept ;
  skos:prefLabel "step count" ;
  skos:definition "Descriptor: formal number of metabolic steps in a transformation (one-, two-, or three-or-more-step). Orthogonal to reaction class; related to composite transformations that package multiple steps as a unit." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "multistep" ;
  skos:altLabel "reaction step count" ;
  skos:altLabel "number of steps" ;
  skos:broader xmet:4000263 .

xmet:4000394 a skos:Concept ;
  skos:prefLabel "quinone formation" ;
  skos:definition "Classical quinone (diketone quinoid with C=O ends), as opposed to quinone-imine or quinone-methide. Ortho (1,2) and para (1,4) specializations sit underneath. A narrowing of quinone-like species formation." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "classical quinone formation" ;
  skos:altLabel "diketone quinone formation" ;
  skos:altLabel "benzoquinone-type formation" ;
  skos:broader xmet:4000059 .

xmet:4000395 a skos:Concept ;
  skos:prefLabel "carbon–carbon dehydrogenation" ;
  skos:definition "Dehydrogenation that changes the bond order between two carbons (alkane→alkene, or alkene→alkyne)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "C–C dehydrogenation" ;
  skos:altLabel "carbon-carbon dehydrogenation" ;
  skos:broader xmet:4000006 .

xmet:4000396 a skos:Concept ;
  skos:prefLabel "aldehyde leaving group" ;
  skos:definition "Aldehyde-equivalent fragment released as a leaving group / coproduct, typically from oxidative dealkylation (formaldehyde from demethylation, acetaldehyde from deethylation, and higher alkanals analogously). Under carbonyl leaving fragment." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "aldehyde leaving fragment" ;
  skos:altLabel "alkanals leaving group" ;
  skos:altLabel "aldehyde-equivalent leaving group" ;
  skos:broader xmet:4000260 .

xmet:4000397 a skos:Concept ;
  skos:prefLabel "cleaved-carbon oxidation state" ;
  skos:definition "Descriptor: oxidation state of the carbon cleaved from a heteroatom (or analogous cleaved carbon) in dealkylation-type chemistry. Orthogonal to reaction-class site shelves (N-demethylation, …)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "cleaved carbon oxidation state" ;
  skos:altLabel "fragment carbon oxidation state" ;
  skos:broader xmet:4000263 .

xmet:4000398 a skos:Concept ;
  skos:prefLabel "alcohol-level cleaved carbon" ;
  skos:definition "Cleaved carbon at alcohol oxidation level (e.g. methanol-/ethanol-equivalent fragment, or C–OH on the cleaved carbon)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "cleaved carbon to alcohol" ;
  skos:altLabel "alcohol-level fragment carbon" ;
  skos:broader xmet:4000397 .

xmet:4000399 a skos:Concept ;
  skos:prefLabel "aldehyde-level cleaved carbon" ;
  skos:definition "Cleaved carbon at aldehyde oxidation level (e.g. formaldehyde-/acetaldehyde-equivalent)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "cleaved carbon to aldehyde" ;
  skos:altLabel "aldehyde-level fragment carbon" ;
  skos:broader xmet:4000397 .

xmet:4000400 a skos:Concept ;
  skos:prefLabel "ketone-level cleaved carbon" ;
  skos:definition "Cleaved carbon at ketone oxidation level (typical methine→carbonyl dealkylation fragment)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "cleaved carbon to ketone" ;
  skos:altLabel "ketone-level fragment carbon" ;
  skos:broader xmet:4000397 .

xmet:4000401 a skos:Concept ;
  skos:prefLabel "carboxylic-level cleaved carbon" ;
  skos:definition "Cleaved carbon at carboxylic-acid oxidation level (e.g. formic-/acetic-equivalent fragment)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "cleaved carbon to carboxylic acid" ;
  skos:altLabel "carboxylic-level fragment carbon" ;
  skos:broader xmet:4000397 .

xmet:4000402 a skos:Concept ;
  skos:prefLabel "carboxylic acid leaving fragment" ;
  skos:definition "Carboxylic-acid-equivalent fragment released as a coproduct (formic, acetic, …). Distinct from carboxylate leaving group in ester hydrolysis." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "carboxylic acid leaving group" ;
  skos:altLabel "released carboxylic acid fragment" ;
  skos:broader xmet:4000260 .

xmet:4000403 a skos:Concept ;
  skos:prefLabel "formic acid leaving fragment" ;
  skos:definition "Formic-acid-equivalent released from demethylation to carboxylic level." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "formic acid leaving group" ;
  skos:broader xmet:4000402 .

xmet:4000404 a skos:Concept ;
  skos:prefLabel "acetic acid leaving fragment" ;
  skos:definition "Acetic-acid-equivalent released from methylene/deethylation to carboxylic level." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "acetic acid leaving group" ;
  skos:broader xmet:4000402 .

xmet:4000405 a skos:Concept ;
  skos:prefLabel "ring closure" ;
  skos:definition "A new ring is formed." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000273 .

xmet:4000406 a skos:Concept ;
  skos:prefLabel "conjugated-system remodeling" ;
  skos:definition "Coordinated multi-site remodeling that builds or extends a conjugated π-system (Forest rule QuinoneFormation). Broader than aromatic quinoid collapse; current Forest patterns only cover aromatic→quinoid endpoints. Children distinguish quinone-like species formation, quinone-like endpoint transformations, and nonaromatic conjugated-system remodeling." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "conjugated π-system remodeling" ;
  skos:altLabel "conjugated-system transformation" ;
  skos:altLabel "Forest QuinoneFormation" ;
  skos:broader xmet:4000213 .

xmet:4000407 a skos:Concept ;
  skos:prefLabel "nonaromatic conjugated-system remodeling" ;
  skos:definition "Conjugated-system remodeling outside aromatic→quinoid collapse. Placement shelf for Forest QuinoneFormation rule breadth that current aromatic patterns do not yet cover." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "nonaromatic conjugated-system transformation" ;
  skos:altLabel "non-aromatic conjugated π-system remodeling" ;
  skos:broader xmet:4000406 .

xmet:4000408 a skos:Concept ;
  skos:prefLabel "phenolic ring-end dehydrogenation" ;
  skos:definition "Ring carbon–OH dehydrogenates to a quinoid carbonyl end ([#6R][#8H] specialization of hydroxy/amino ring-end dehydrogenation)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "phenol to quinoid carbonyl end" ;
  skos:altLabel "ring C–OH quinoid dehydrogenation" ;
  skos:broader xmet:4000327 .

xmet:4000409 a skos:Concept ;
  skos:prefLabel "anilinic ring-end dehydrogenation" ;
  skos:definition "Ring carbon–NH₂/NHR dehydrogenates to a quinoid C=NH/C=NR end ([#6R][#7D1H2,#7D2H1] specialization of hydroxy/amino ring-end dehydrogenation). Distinct from tertiary-nitrogen iminium (QuinoneFormation/iminium, #7D3)." ;
  skos:inScheme xmet:scheme ;
  skos:altLabel "aniline to quinoid imine end" ;
  skos:altLabel "ring C–NH quinoid dehydrogenation" ;
  skos:broader xmet:4000327 .

xmet:4000410 a skos:Concept ;
  skos:prefLabel "oxidative deiodination" ;
  skos:definition "oxidative deiodination: xenobiotic-metabolism term under oxidative dehalogenation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000307 .

xmet:4000411 a skos:Concept ;
  skos:prefLabel "reductive debromination" ;
  skos:definition "reductive debromination: xenobiotic-metabolism term under reductive dehalogenation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000288 .

xmet:4000412 a skos:Concept ;
  skos:prefLabel "reductive deiodination" ;
  skos:definition "reductive deiodination: xenobiotic-metabolism term under reductive dehalogenation." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000288 .

xmet:4000413 a skos:Concept ;
  skos:prefLabel "deethylation" ;
  skos:definition "Oxidative deethylation at N/O (heteroatom-general). Parallel to demethylation; N- and O-deethylation specialize by heteroatom elsewhere in the tree (single-parent homes)." ;
  skos:inScheme xmet:scheme ;
  skos:broader xmet:4000343 .

